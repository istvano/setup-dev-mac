#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
need_uv() { command -v uv >/dev/null 2>&1 || { echo 'uv is required' >&2; exit 1; }; }
case "${1:-help}" in
  sync) need_uv; (cd "$ROOT" && uv sync) ;;
  serve) model="${2:-}"; port="${3:-8080}"; [[ -n "$model" && "$port" =~ ^[0-9]+$ ]] || exit 1; need_uv; (cd "$ROOT" && exec uv run mlx_lm.server --model "$model" --host 127.0.0.1 --port "$port") ;;
  generate) model="${2:-}"; shift 2 || true; prompt="$*"; [[ -n "$model" && -n "$prompt" ]] || exit 1; need_uv; (cd "$ROOT" && exec uv run mlx_lm.generate --model "$model" --prompt "$prompt") ;;
  jupyter) need_uv; (cd "$ROOT" && exec uv run jupyter lab) ;;
  verify) need_uv; (cd "$ROOT" && uv run python -c 'import mlx, mlx_lm; print("MLX/MLX-LM: OK")' && uv run mlx_lm.server --help >/dev/null) ;;
  *) echo 'mlxctl sync|serve MODEL [PORT]|generate MODEL PROMPT|jupyter|verify' ;;
esac
