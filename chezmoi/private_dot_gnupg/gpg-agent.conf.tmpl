# gpg-agent configuration.
{{ if lookPath "pinentry-mac" -}}
# pinentry-mac gives a native passphrase prompt and offers to store the
# passphrase in the macOS Keychain, so signing does not prompt on every commit.
pinentry-program {{ lookPath "pinentry-mac" }}
{{- else -}}
# pinentry-mac is not installed. Add it to profiles/core.Brewfile, or gpg will
# fall back to a terminal prompt that GUI Git clients cannot answer.
{{- end }}

# Cache the passphrase for 30 minutes of inactivity, 8 hours maximum. Long
# enough for a working session, short enough that an unattended unlocked machine
# does not stay able to sign indefinitely.
default-cache-ttl 1800
max-cache-ttl 28800

# gpg-agent does not serve SSH keys here: ~/.ssh/config uses the password
# manager's agent, and running two SSH agents makes it ambiguous which key
# answers a request. The default-cache-ttl-ssh and max-cache-ttl-ssh settings
# are therefore deliberately absent — they take effect only with
# enable-ssh-support, so setting them would be dead configuration.
