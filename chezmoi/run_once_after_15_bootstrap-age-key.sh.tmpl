{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Create the age identity that SOPS uses, if one does not already exist.
#
# age is in the core profile and sops in security-extra, but neither had a
# key-management story, so encrypted project files could not actually be
# created. The private key is written to ~/.config/age/keys.txt with mode 0600
# and is never placed in this repository. Only age is required here.
#
# For a hardware-backed identity instead, install security-extra and use
# age-plugin-yubikey; this script leaves an existing key untouched.
set -Eeuo pipefail

{{ template "brew-shellenv" . }}

KEY_DIR="{{ joinPath .chezmoi.homeDir ".config/age" }}"
KEY_FILE="$KEY_DIR/keys.txt"

# age-keygen present at render time: {{ if lookPath "age-keygen" }}yes{{ else }}no{{ end }}
#
# That line is what makes this retry, and it is load-bearing rather than informational.
#
# This is a run_once_ script, so chezmoi keys it on the file's hash and never runs it
# again once it has exited — and the guard below exits 0, deliberately, so a missing age
# does not fail the apply. Together those meant: apply hook 10 tolerates `brew bundle`
# failing (documented, for the no-bottle case), so if age was among the casualties this
# printed one WARN, was recorded as done, and NOTHING ever created the identity. Fixing
# Homebrew afterwards did not help, because the file's content never changed. SOPS was
# then unusable and neither script/verify nor hardening-check looks for the key.
#
# Rendering whether age-keygen exists means the content DOES change once it is installed,
# so the next apply re-runs this and creates the identity. The body is idempotent: an
# existing key is left alone.
command -v age-keygen >/dev/null 2>&1 || {
  echo "[WARN] age is not installed, so no age identity was created." >&2
  echo "       SOPS cannot encrypt or decrypt without one." >&2
  echo "       Install it and re-apply:  brew install age && ./script/setup" >&2
  exit 0
}

if [[ -f "$KEY_FILE" ]]; then
  echo "[OK] An age identity already exists at $KEY_FILE."
  exit 0
fi

umask 077
mkdir -p "$KEY_DIR"

# Restore from Bitwarden BEFORE minting a new identity.
#
# This is the difference between a portable machine and a lossy one. SSH keys are generated
# per machine on purpose (hook 12) because a new signing key is simply enrolled. An age key
# has no such property: files encrypted to an identity you no longer hold are unrecoverable,
# so a new Mac that quietly mints a second identity has destroyed access to every existing
# SOPS file. The old script did exactly that, and printed "back this key up now" at the
# moment it was already too late for the previous machine's key.
#
# The vault is only consulted when `bw` is present AND already unlocked — `bw` reads
# BW_SESSION and this runs without a terminal, so it cannot prompt. A locked vault is not an
# error here; it means the restore has to happen later, which script/identity --restore does.
BW_ITEM="${AGE_BW_ITEM:-age-identity}"
restored=false

if command -v bw >/dev/null 2>&1; then
  if bw get notes "$BW_ITEM" >"$KEY_FILE.tmp" 2>/dev/null &&
    grep -q 'AGE-SECRET-KEY-' "$KEY_FILE.tmp"; then
    mv "$KEY_FILE.tmp" "$KEY_FILE"
    chmod 600 "$KEY_FILE"
    restored=true
  else
    rm -f "$KEY_FILE.tmp"
  fi
fi

if [[ "$restored" == true ]]; then
  echo "[OK] Restored the age identity from Bitwarden item '$BW_ITEM'."
  echo "     Public key: $(age-keygen -y "$KEY_FILE")"
  exit 0
fi

age-keygen -o "$KEY_FILE" 2>/dev/null
chmod 600 "$KEY_FILE"

# A marker, so "this key is not backed up" is a fact the tooling can report rather than
# something the operator has to remember. script/identity --check reads it and keeps
# complaining until the key is in the vault and the marker is removed.
: >"$KEY_DIR/.locally-generated"

cat >&2 <<EOF
[WARN] No age identity was found in Bitwarden, so a NEW one was generated.
       If this machine is replacing another, STOP: files encrypted to the old
       identity cannot be read with this one. Restore the old key instead:
         ./script/identity --restore

       If this is genuinely the first machine, store this key in Bitwarden now,
       as a secure note in an item named '$BW_ITEM':
         $KEY_FILE
       Public key, for .sops.yaml recipients:
         $(age-keygen -y "$KEY_FILE")
EOF
{{- end }}
