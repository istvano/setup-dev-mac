{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Turn off the telemetry that no environment variable can reach.
#
# Most of the opt-outs in ADR-046 are environment variables and live in the shell
# configuration, where they apply to every invocation without state. These three do not
# have one: each is a setting the tool writes into its own config file, so it has to be
# set once, per machine, by running the tool.
#
# Settings: {{ range $i, $s := (list "go-telemetry-off" "gcloud-disable-usage-reporting" "aider-analytics-disable") }}{{ if $i }} {{ end }}{{ $s }}{{ end }}
#
# That line is load-bearing: run_onchange hashes the rendered script, so listing the
# settings in the body is what makes this hook re-run when the list changes. Same
# construction as hooks 28 and 29.
#
# Every step is guarded on the tool being present and is a no-op when the setting is
# already correct, so a re-apply is silent and costs no network.
#
# NOT here, deliberately:
#
#   VS Code and Zed. Both are settings.json edits, and vscode/README.md states the
#   boundary this repository keeps: "The scripts do not edit settings.json — that file
#   is yours." Owning the telemetry key would mean owning the file. They are manual
#   steps in docs/MANUAL-SECURITY.md instead, which is where the other decisions that
#   only a human can make already live.
#
#   Homebrew, Azure CLI, OpenTofu. Environment variables, already set by both shells.
set -Eeuo pipefail

{{ template "brew-shellenv" . }}

# Go's telemetry defaults to "local": counters are written to disk and NOT uploaded
# unless the mode is changed to "on". So this is not closing an open channel — it is
# declining to collect at all, which is the stricter of the two and the one worth
# stating. `go telemetry` was added in Go 1.23; the guard covers an older toolchain.
if command -v go >/dev/null 2>&1 && go telemetry >/dev/null 2>&1; then
  if [[ "$(go telemetry 2>/dev/null)" != "off" ]]; then
    echo "[INFO] Disabling Go telemetry collection." >&2
    go telemetry off || echo "[WARN] Could not set Go telemetry to off." >&2
  fi
fi

# gcloud reports usage only if you opted in at install time, so this is defensive
# rather than corrective — and it is worth being defensive, because the installer asks
# and an answer given once on a tired evening is not a decision anyone remembers.
if command -v gcloud >/dev/null 2>&1; then
  if [[ "$(gcloud config get-value disable_usage_reporting 2>/dev/null)" != "True" ]]; then
    echo "[INFO] Disabling gcloud usage reporting." >&2
    gcloud config set disable_usage_reporting true >/dev/null 2>&1 ||
      echo "[WARN] Could not disable gcloud usage reporting." >&2
  fi
fi

# aider's analytics are opt-in and it asks before enabling them. --analytics-disable
# records a permanent "no" so the question is answered before it is asked, which
# matters for a tool that prompts inside an interactive session.
if command -v aider >/dev/null 2>&1; then
  if ! grep -qs '^analytics-disable: *true' "$HOME/.aider.conf.yml" 2>/dev/null; then
    echo "[INFO] Disabling aider analytics." >&2
    aider --analytics-disable --exit >/dev/null 2>&1 ||
      echo "[WARN] Could not disable aider analytics; run 'aider --analytics-disable'." >&2
  fi
fi

# Never fatal. chezmoi stops at the first failing script, so a telemetry setting that
# will not apply must not cost hooks 35, 40, 45 and 90 — the VS Code extensions, the
# macOS defaults, the browser profiles and the security reminder.
exit 0
{{- end }}
