{{- /* private_ so chezmoi applies 0600; ssh refuses a group-readable config. */ -}}
# SSH client configuration.
#
# Algorithm lists are allowlists rather than exclusions, so a future weak
# default cannot be silently negotiated.

# Included FIRST, deliberately. ssh takes the first value it obtains for each
# keyword, so anything after the `Host *` block below could never override it.
# Per-host settings live here and are not managed by the repository, so
# machine-specific hostnames never reach version control.
Include ~/.ssh/config.d/*

Host *
  # Keys are added to the agent on first use and unlocked from the Keychain.
  # UseKeychain is Apple's ssh only: a Homebrew openssh would reject this file.
  AddKeysToAgent yes
  UseKeychain yes

  # Only offer the key configured for a host. Without this, ssh walks every key
  # in the agent and leaks which identities exist to any server it contacts.
  #
  # This has a requirement worth knowing before it bites: under IdentitiesOnly,
  # ssh uses only the configured identity files even when an agent offers more.
  # Keys held solely in an agent are therefore skipped. Give each host in
  # config.d an `IdentityFile ~/.ssh/<name>.pub` — the public key is enough, and
  # is how ssh selects one specific identity out of an agent.
  IdentitiesOnly yes

  HashKnownHosts yes
  StrictHostKeyChecking ask
  VerifyHostKeyDNS no

  KexAlgorithms sntrup761x25519-sha512@openssh.com,curve25519-sha256,curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
  HostKeyAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
  Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
  MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
  PubkeyAcceptedAlgorithms ssh-ed25519,ssh-ed25519-cert-v01@openssh.com,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256

  # Agent and X11 forwarding expose the client to a compromised server. Enable
  # them per host, deliberately, never globally.
  ForwardAgent no
  ForwardX11 no

  ServerAliveInterval 60
  ServerAliveCountMax 3
{{ if eq .passwordManager "1password" }}
  # 1Password holds the private keys; the local agent socket exposes only the
  # items you have explicitly authorised.
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else }}
  # A per-machine key on disk, generated by run_onchange_after_12 and never
  # copied anywhere. Each Mac has its own; the private key does not travel.
  #
  # This replaced Bitwarden's SSH agent deliberately. Two reasons, one of them a
  # bug the agent could not solve:
  #
  #   * A key that never leaves the machine that made it cannot be leaked by
  #     losing a different machine. Enrolling one public key per Mac means
  #     revoking a lost Mac is one action at the forge, not a key rotation.
  #   * git's ssh signing did not work through the agent at all. With
  #     gpg.format=ssh and no gpg.ssh.program, git shells out to `ssh-keygen`,
  #     which reads $SSH_AUTH_SOCK and never parses this file — so IdentityAgent
  #     had no effect on signing and every commit failed. Naming a real file
  #     makes ssh-keygen sign against it directly.
  #
  # Trade-off, stated rather than hidden: the key is on disk with no passphrase,
  # so it is protected by FileVault rather than by a second factor. Add one with
  # `ssh-keygen -p -f ~/.ssh/id_ed25519`; AddKeysToAgent and UseKeychain above
  # mean you would be asked once and then not again.
  IdentityFile ~/.ssh/id_ed25519
{{- end }}
