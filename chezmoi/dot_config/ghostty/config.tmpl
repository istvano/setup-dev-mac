# Ghostty terminal configuration.
# Reference: https://ghostty.org/docs/config

# The family is "JetBrainsMono Nerd Font Mono", with the trailing Mono.
# font-jetbrains-mono-nerd-font installs only the monospaced variants, and
# `ghostty +list-fonts` exposes exactly four JetBrains families:
#   JetBrainsMono NFM, JetBrainsMono Nerd Font Mono,
#   JetBrainsMonoNL NFM, JetBrainsMonoNL Nerd Font Mono
# "JetBrainsMono Nerd Font" is none of them. Unlike a bad theme, which stops
# Ghostty starting, an unresolvable font falls back silently — the terminal opens
# in a default face and nothing says why. NL means no ligatures.
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Theme names are Ghostty's own, exactly as `ghostty +list-themes` prints them:
# capitalised, space-separated. They were written here in the lowercase-hyphenated
# style used elsewhere, and Ghostty refused to start at all — the one failure in
# this file that is loud rather than silent.
#
# `+show-config` does NOT catch this. It echoes the parsed value without
# resolving the theme, and reported the broken spelling as configured. Only
# `ghostty +validate-config` resolves it.
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
window-padding-x = 8
window-padding-y = 6
window-save-state = never

# A memory bound per terminal surface, in BYTES. 50 MB.
#
# The units are the whole story. This key counts bytes, and it was once set to
# `10000` here as though it were a line count: a 10 KB buffer against the 10 MB
# default, roughly a hundred lines rather than ten thousand.
#
# `scrollback-limit-lines` would say what is meant, but it does not exist on the
# Ghostty this repository installs. Ghostty 1.4 adds it and renames this key to
# `scrollback-limit-bytes`; `cask "ghostty"` is 1.3.1, which knows neither, and
# rejects an unknown key with a config error. The byte key survives the 1.4
# rename through a compatibility alias, so it is the one spelling correct on
# both.
#
# Ghostty never writes scrollback to disk, so this is purely about memory. It is
# not a privacy control, and an earlier comment here wrongly claimed it was.
# tests/placement-policy.sh asserts the value is plausible for its units.
scrollback-limit = 52428800

copy-on-select = false
confirm-close-surface = true

# Ghostty can detect the shell, but naming it means the selection in
# ~/.config/chezmoi/chezmoi.toml is what decides, not whatever the surface
# happens to launch.
shell-integration = {{ .shell }}
{{ if eq .shell "fish" }}
# `command` runs fish in every new surface WITHOUT changing the account login
# shell, which stays zsh. That is the point: a fish configuration that fails to
# parse costs a terminal tab, not the ability to log in. `chsh` is a separate,
# manual step documented in docs/OPERATIONS.md.
#
# --login is required, not cosmetic. fish applies /etc/paths and /etc/paths.d
# only when it is a login shell — `status is-login && command -sq
# /usr/libexec/path_helper` in its own share/config.fish — and those are how
# macOS installers put themselves on PATH. Without it, fish starts fine and
# quietly lacks entries zsh has.
#
# The prefix is resolved at apply time by the brew-prefix template, because
# `command` is a static string rather than a shell and cannot ask brew --prefix
# itself. That is /opt/homebrew on Apple Silicon and /usr/local on Intel.
command = {{ template "brew-prefix" . }}/bin/fish --login
{{ end }}

# ssh-env and ssh-terminfo both default to off. Ghostty exports
# TERM=xterm-ghostty, which remote hosts do not have in their terminfo database,
# so vim, tmux and other curses programs degrade over SSH. ssh-terminfo installs
# the entry on the remote; ssh-env falls back to a portable TERM when it cannot.
# This machine SSHes into Lima VMs and Kubernetes nodes, so both earn their place.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo

# Unset, Ghostty defers to Sparkle and may install updates on its own, outside
# `brew upgrade` and ./script/update-report. `check` notifies without installing,
# which keeps new code arriving through a reviewed step.
auto-update = check

macos-option-as-alt = true
macos-titlebar-style = tabs
clipboard-read = ask
clipboard-write = allow
clipboard-paste-protection = true
