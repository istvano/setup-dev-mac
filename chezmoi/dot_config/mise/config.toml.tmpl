[settings]
experimental = true
idiomatic_version_file_enable_tools = ["node", "python", "java", "go"]
{{- if has "dev" .profiles }}
# Runtimes are pinned to explicit minor versions rather than tracking "latest"
# or "lts". A floating version means the toolchain can change under a project
# without any edit, which is the same objection ADR-006 raises about mutable
# image tags and the MCP policy raises about @latest. Bumping one is a reviewed
# edit to this file. See ADR-030.
[tools]
node = "24"
# Go supports the two most recent majors and nothing older. 1.25 sat here until
# 1.27 shipped, at which point it stopped receiving security fixes — silently,
# because nothing checked it. script/update-report now does.
#
# 1.26 rather than 1.27 is a choice, not a default: it is in support today and is
# the smaller step from what projects were building against. It falls out of
# support when 1.28 ships, which is the point to move again.
go = "1.26"
# pnpm 10 was a full major behind. 11 changes global-install and lockfile
# behaviour, so a project that has not been opened since is worth a check.
pnpm = "11"
# Python was listed in idiomatic_version_file_enable_tools above but never in [tools], so
# mise honoured a .python-version and installed nothing — `python3` resolved to Apple's
# system build, which is not a runtime anyone chose. uv stays the project-level tool for
# dependencies and virtualenvs; this pins the interpreter underneath it.
#
# 3.14 does not disturb aider, which requires <3.13 and gets its own CPython 3.12
# from uv rather than from here (ADR-044). Nothing else depends on 3.13.
python = "3.14"
# The JVM ecosystem, all of it, from the same manager that owns every other language.
#
# SDKMAN is the usual answer here and was considered. It is not in homebrew-core, so
# installing it means either a third-party tap (which ADR-020 rejected for AeroSpace and
# tflint) or curl-pipe-bash (which ADR-006 and AGENTS.md forbid) — and its installer
# appends its own init to ~/.zshrc, the file chezmoi owns, which is the same fight that
# made Rancher Desktop expensive enough to drop in ADR-037. mise covers the same ground,
# so the JVM is not a special case needing a second manager. See the ADR-021 amendment.
#
# Three JDKs: 21 is the default because it is first, 17 is present because Couchbase SDK and
# connector work still spans it. `mise use java@temurin-17` in a project switches it, which
# is the per-project selection SDKMAN users expect.
#
# 25 is the newest LTS and is APPENDED, deliberately. mise takes the first entry as the
# default, so putting 25 first would move every project that has not asked for a JDK onto a
# new major without an edit anywhere in that project. Listing it last makes it available to
# `mise use java@temurin-25` and changes nothing else. Promoting it is a one-line edit when
# the work has actually been tried on it.
java = ["temurin-21", "temurin-17", "temurin-25"]
maven = "3.9"
gradle = "9"
kotlin = "2.4"
# mise manages Rust by driving rustup and installing rustup itself when absent,
# so Homebrew does not also install one. See ADR-021.
rust = "stable"
# The one entry here that is a CLI rather than a runtime, and the reasoning is in
# ADR-044. Cline's own install instruction is `npm i -g cline`; that would land
# under whichever Node prefix mise currently owns and disappear at the next `node`
# bump, run every lifecycle script in the tree, and leave the version undeclared.
# The npm: backend keeps the pin in the same file that decides the Node version,
# and mise orders node ahead of npm: tools.
#
# Pinned, not "latest", for the reason ADR-030 pins the runtimes above.
#
# Two facts worth knowing before bumping it:
#
#   1. It resolves a PRE-BUILT, Bun-embedded binary from a per-platform optional
#      dependency (@cline/cli-darwin-arm64). That is half of why homebrew-core
#      deprecated the `cline` formula, so it is stated rather than glossed. npm
#      carries an integrity hash, a registry signature and an SLSA v1 provenance
#      attestation for it, which is a better record than the formula offered.
#   2. Do NOT add allow_builds. mise's embedded aube installer denies dependency
#      lifecycle scripts by default, and cline's own postinstall only hard-links
#      that binary to bin/.cline as a startup optimisation — bin/cline walks
#      node_modules for it at runtime when the link is absent. Denying the script
#      costs launch latency, not function.
#
# @cline/llms pulls ollama-ai-provider-v2. That is an API CLIENT, not the Ollama
# runtime, so ADR-025 is intact — recorded here because profiles/AGENTS.md warns
# that the placement test matches literal tokens and cannot see a bundled engine.
"npm:cline" = "3.0.55"
{{- end }}
