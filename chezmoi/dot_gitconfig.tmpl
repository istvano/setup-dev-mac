[user]
  name = {{ .gitName | quote }}
  email = {{ .gitEmail | quote }}
{{- if and .gitSigningKey (ne .gitSigningMethod "none") }}
  signingkey = {{ .gitSigningKey | quote }}
{{- end }}
[init]
  defaultBranch = main
[core]
{{- if lookPath "nvim" }}
  editor = nvim
{{- else }}
  editor = code --wait
{{- end }}
  pager = delta
  excludesfile = {{ joinPath .chezmoi.homeDir ".config/git/ignore" | quote }}
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[diff]
  algorithm = histogram
  colorMoved = default
{{- if lookPath "code" }}
  tool = vscode
{{- end }}
[merge]
  conflictstyle = zdiff3
{{- if lookPath "code" }}
  tool = vscode
{{- end }}
{{- if lookPath "code" }}

# VS Code for interactive diffs and three-way merges.
#
# This does NOT replace delta. `git diff` goes through core.pager, which stays
# delta in the terminal; `git difftool` and `git mergetool` are separate commands
# that launch an external tool on demand. The two are complementary, and reading
# a diff in the pager remains the common case.
#
# Both need a graphical session. Over a plain SSH connection `code --wait` has
# nothing to open and will hang, so use the terminal tools there.
#
# The absolute path is deliberate, for the same reason as gpg.program below: a
# GUI Git client does not inherit the shell PATH and would not find `code`.
[difftool]
  prompt = false
[difftool "vscode"]
  cmd = {{ lookPath "code" | quote }} --wait --diff $LOCAL $REMOTE
[mergetool]
  prompt = false
  # No .orig files left behind after a resolved conflict.
  keepBackup = false
[mergetool "vscode"]
  # `code --merge` takes path1, path2, base, result — verified against VS Code's
  # own argument definition, where the two modified versions come first and the
  # output file last. $LOCAL is placed first so the side that is already yours
  # appears where git puts it everywhere else: ours before theirs, as in the
  # conflict markers zdiff3 writes above.
  cmd = {{ lookPath "code" | quote }} --wait --merge $LOCAL $REMOTE $BASE $MERGED
{{- end }}
# Git LFS. Declared here rather than left to `git lfs install`, which writes exactly
# these four keys into this file — a file chezmoi owns, so a run-once hook doing it
# would be reported as an external modification on every apply.
#
# `required = true` is what makes a missing git-lfs binary an ERROR rather than a
# silent pass-through. Without it, cloning a model repository on a machine where
# git-lfs is absent quietly produces pointer files instead of weights, and the symptom
# looks like a corrupt model. Failing loudly is the whole point.
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[rerere]
  enabled = true
[pull]
  ff = only
[fetch]
  prune = true
[push]
  autoSetupRemote = true
  followTags = true
[submodule]
  recurse = true
[column]
  ui = auto
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[rebase]
  autosquash = true

# Without a helper, git caches no HTTPS credential for any host. `gh` covers
# GitHub only, so every other remote would re-prompt.
[credential]
  helper = osxkeychain

# Reject malformed objects instead of writing them into the object store. This
# is cheap and blocks a class of repository-delivered attacks.
[transfer]
  fsckObjects = true
[receive]
  fsckObjects = true
{{- $signing := and .gitSigningKey (ne .gitSigningMethod "none") }}
{{- if $signing }}
{{- if eq .gitSigningMethod "gpg" }}

# OpenPGP commit signing. `user.signingkey` above is the key ID; find it with
#   gpg --list-secret-keys --keyid-format=long
# gpg-agent handles the passphrase through pinentry-mac and can cache it in the
# Keychain, so signing does not prompt on every commit.
[gpg]
  format = openpgp
{{- if lookPath "gpg" }}
  # Absolute path so GUI Git clients, which do not inherit the shell PATH, can
  # still find the Homebrew gpg rather than falling back to a system binary.
  program = {{ lookPath "gpg" | quote }}
{{- end }}
{{- else }}

# SSH-based commit signing. In every intended configuration the private key
# stays off disk: 1Password's agent, Secretive's Secure Enclave agent, or a
# YubiKey resident key holds it.
[gpg]
  format = ssh
[gpg "ssh"]
  allowedSignersFile = {{ joinPath .chezmoi.homeDir ".config/git/allowed_signers" | quote }}
{{- if eq .passwordManager "1password" }}
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- end }}
{{- end }}
[commit]
  gpgsign = true
[tag]
  gpgsign = true
{{- end }}
{{- if .workGitEmail }}

# Work repositories use a separate identity, mirroring the personal/work split
# the browser profiles already enforce. Keep work repositories under this path.
[includeIf {{ printf "gitdir:%s/" .workGitDir | quote }}]
  path = {{ joinPath .chezmoi.homeDir ".config/git/config-work" | quote }}
{{- end }}
