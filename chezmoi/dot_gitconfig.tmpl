[user]
  name = {{ .gitName | quote }}
  email = {{ .gitEmail | quote }}
[init]
  defaultBranch = main
[core]
  editor = code --wait
  pager = delta
[interactive]
  diffFilter = delta --color-only
[delta]
  navigate = true
  line-numbers = true
[merge]
  conflictstyle = zdiff3
[pull]
  ff = only
[fetch]
  prune = true
[push]
  autoSetupRemote = true
