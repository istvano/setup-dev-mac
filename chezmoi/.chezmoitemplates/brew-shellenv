# Vendor-generated shell initialisation. Chezmoi run scripts do not inherit an
# interactive shell's PATH, so Homebrew has to be located explicitly.
#
# The prefix is architecture-dependent: /opt/homebrew on Apple Silicon,
# /usr/local on Intel. Apple Silicon is checked first, so a Mac carrying both
# resolves to the native install rather than a translated one.
for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x "$__brew" ]]; then
    eval "$("$__brew" shellenv)"
    break
  fi
done
unset __brew
