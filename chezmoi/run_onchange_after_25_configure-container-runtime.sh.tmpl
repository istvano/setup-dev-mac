{{- if and (eq .chezmoi.os "darwin") (ne .runtime "none") -}}
{{- /* Repository scripts live one level above .chezmoi.sourceDir; see .chezmoiroot. */ -}}
{{- $repo := dir .chezmoi.sourceDir -}}
#!/usr/bin/env bash
set -Eeuo pipefail

{{ template "brew-shellenv" . }}
{{ if eq .runtime "colima" }}
# Colima is the default runtime (ADR-037). This hook deliberately does NOT start it.
#
# The substrate VM is 8 CPUs, 14 GiB and a 100 GiB disk. Creating it downloads a
# guest image and takes minutes, and it is a standing memory cost that should begin
# when the operator decides, not as a side effect of applying dotfiles. Every other
# heavyweight or privileged step in this repository is opt-in for the same reason:
# FileVault, Touch ID for sudo, macOS defaults, the MCP policy.
#
# So this reports the state and names the one command that changes it. It is also
# why ~/.colima/default/colima.yaml is NOT chezmoi-managed: `colima start` rewrites
# that file because --save-config defaults to true, and a chezmoi-managed file the
# tool rewrites is the fight that made Rancher Desktop expensive.
if ! command -v colima >/dev/null 2>&1; then
  echo "[WARN] colima is not installed yet; skipping the substrate report." >&2
  echo "       Re-run ./script/setup once packages have installed." >&2
  exit 0
fi

if {{ joinPath $repo "script/container-substrate" | quote }} --verify >/dev/null 2>&1; then
  echo "[OK] Container substrate is present and matches the declared state."
else
  echo "[INFO] The container substrate is not set up yet, or has drifted."
  echo "       Nothing is started automatically: the VM is 14 GiB of standing"
  echo "       memory and takes minutes to create."
  echo "       Review it, then create it:"
  echo "         ./script/container-substrate --dry-run"
  echo "         ./script/container-substrate"
fi
{{ else if eq .runtime "rancher" }}
# Rancher Desktop is no longer the default (ADR-037) but remains selectable, so this
# branch is kept. Everything below exists because Rancher fights the configuration:
# it needs a running GUI app to accept settings, and its default path-management
# strategy rewrites the shell files chezmoi owns.
open -gj -a "Rancher Desktop" || true

find_rdctl() {
  local candidate
  for candidate in \
    "$HOME/.rd/bin/rdctl" \
    "/Applications/Rancher Desktop.app/Contents/Resources/resources/darwin/bin/rdctl"
  do
    [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
  done
  command -v rdctl 2>/dev/null || return 1
}

for _ in $(seq 1 60); do
  RDCTL="$(find_rdctl || true)"
  if [[ -n "$RDCTL" ]] && "$RDCTL" list-settings >/dev/null 2>&1; then
    # Answering `list-settings` does not mean the API will accept a write:
    # Rancher Desktop returned 500 to this `set` while still starting up, and an
    # unguarded failure here aborted every remaining apply hook.
    # path-management-strategy=manual matters as much as the engine choice.
    # The default, "rcfiles", makes Rancher Desktop append an export block to
    # ~/.zshrc and friends — files chezmoi owns. chezmoi then reports the target
    # as modified outside its control on every apply, and prompts to overwrite;
    # overwriting removes the block, Rancher re-adds it on next start, forever.
    # The shell configurations add ~/.rd/bin themselves instead.
    if "$RDCTL" set --container-engine.name=moby --kubernetes-enabled=false \
      --application.path-management-strategy=manual; then
      exit 0
    fi
    echo "[WARN] rdctl rejected the settings change; Rancher Desktop may still be" >&2
    echo "       starting. Set Moby/Docker and disable Kubernetes in Preferences," >&2
    echo "       or re-run ./script/setup once it is up." >&2
    exit 0
  fi
  sleep 2
done

echo "[WARN] Rancher Desktop was installed but could not be configured automatically." >&2
echo "       Select Moby/Docker and disable Kubernetes in Preferences." >&2
{{ else }}
# OrbStack manages its own VM and needs no configuration from this repository. The
# shared network, registry and build cache still apply, so the substrate is reported
# the same way as for Colima.
if command -v docker >/dev/null 2>&1 &&
  {{ joinPath $repo "script/container-substrate" | quote }} --verify >/dev/null 2>&1; then
  echo "[OK] Container substrate is present and matches the declared state."
else
  echo "[INFO] Container substrate not set up: ./script/container-substrate" >&2
fi
{{ end }}
{{- end }}
