# Interactive zsh configuration.
#
# Every activation stays guarded by `command -v` so a partially installed
# workstation still gets a usable shell.

# --- PATH --------------------------------------------------------------------

[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || export PATH="$HOME/.local/bin:$PATH"
# Homebrew's prefix is architecture-dependent: /opt/homebrew on Apple Silicon,
# /usr/local on Intel. Resolved at shell start rather than baked in at apply time,
# so the same file works on either. Apple Silicon first, so a Mac with both
# installs gets the native one rather than a translated one.
for __brew in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [[ -x "$__brew" ]]; then
    eval "$("$__brew" shellenv)"
    break
  fi
done
unset __brew
# Rust comes from mise, which shims cargo and rustc; no Homebrew keg on PATH.

# --- Completion --------------------------------------------------------------

if command -v brew >/dev/null 2>&1; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:$FPATH"
fi
# complist provides the menuselect keymap that the `menu select` zstyle below
# relies on; without it, menu selection silently falls back to plain listing.
zmodload zsh/complist
autoload -Uz compinit compaudit
# compinit prompts interactively when it finds group- or world-writable
# completion directories, which can hang a non-interactive login. Report them
# instead, so an unsafe directory is noticed rather than silently trusted.
if compaudit >/dev/null 2>&1; then
  compinit
else
  print -u2 'zsh: insecure completion directories found; run compaudit to review them'
  compinit -i
fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'

# Cache generated completions. kubectl, aws and docker have large completion
# sets that are slow to recompute on every invocation.
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompcache"

# --- Keymap ------------------------------------------------------------------

# Chosen explicitly, because otherwise it is a side effect of $EDITOR: zsh uses
# viins when VISUAL or EDITOR contains the string "vi", and "nvim" does. Without
# this line the shell silently starts in vi mode and plugin keybindings land in
# a keymap nobody selected.
bindkey -e

# --- History -----------------------------------------------------------------

# Atuin is the primary history store, but zsh keeps its own file as well and it
# is read by anything that does not know about Atuin.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_SPACE     # a leading space keeps a command out of history
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY           # expand a history reference for review, do not run it
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_FCNTL_LOCK       # safe concurrent writes; SHARE_HISTORY means many
                             # terminals append to the same file
setopt INTERACTIVE_COMMENTS  # pasting a command with a trailing # comment works

# --- Directory stack ---------------------------------------------------------

setopt AUTO_PUSHD            # every cd pushes, so `cd -<Tab>` lists recent dirs
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT          # pushd/popd do not print the stack

# --- Line editing ------------------------------------------------------------

# Zsh's default WORDCHARS includes "/", which makes Ctrl-W delete a whole path
# instead of one segment. Removing it is the single most useful zsh line-editing
# fix; the rest of the default set is preserved.
WORDCHARS="${WORDCHARS//\//}"

# --- Tool activation ---------------------------------------------------------

command -v mise >/dev/null 2>&1 && eval "$(mise activate zsh)"
command -v direnv >/dev/null 2>&1 && eval "$(direnv hook zsh)"
command -v starship >/dev/null 2>&1 && eval "$(starship init zsh)"
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# ORDER MATTERS. fzf and Atuin both bind Ctrl-R, and the one initialised last
# wins. Atuin is the history store this workstation is built around, so it goes
# after fzf. Reversing these two silently replaces Atuin search with fzf's,
# which still works and is therefore easy not to notice.
# tests/placement-policy.sh asserts this order.
command -v fzf >/dev/null 2>&1 && eval "$(fzf --zsh)"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-ai)"

# fzf uses fd so results honour .gitignore and skip .git.
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
fi
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'

# --- Editor ------------------------------------------------------------------

# Prefer a terminal editor: `code --wait` is unusable over SSH or in recovery.
if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
else
  export EDITOR="code --wait"
fi
export VISUAL="$EDITOR"

# --- Aliases -----------------------------------------------------------------

# eza replaces ls. --icons=auto needs a Nerd Font, which core.Brewfile installs
# and dot_config/ghostty/config selects; `auto` restricts icons to a real
# terminal, so a redirect or a pipe still produces plain parsable output.
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons=auto --group-directories-first'
  alias ll='eza -l --git --icons=auto --group-directories-first'
  alias la='eza -la --git --icons=auto --group-directories-first'
  alias lt='eza --tree --level=2 --icons=auto --group-directories-first'
fi
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'

# `rm` is deliberately not aliased to trash. Redefining it builds a habit that
# does not transfer to another machine, a container, or anything run under sudo,
# where the same keystrokes delete irreversibly. Call trash by name.

# --- Environment -------------------------------------------------------------

export GPG_TTY="$TTY"
export LESS='-R'

# A stricter umask is deliberately not set here: Homebrew fails to build several
# formulae under umask 077. Rely on FileVault and per-file modes instead.

# --- Plugins -----------------------------------------------------------------

# Cap what zsh-syntax-highlighting will parse. It re-highlights the entire
# buffer on every keystroke, so a long pasted command makes typing crawl. This
# MUST be set before the plugin is sourced; afterwards it has no effect, which
# tests/placement-policy.sh asserts.
ZSH_HIGHLIGHT_MAXLENGTH=512

# Syntax highlighting must be sourced last; it wraps the widgets everything
# else has already registered. The prefix is resolved at shell start rather than
# at chezmoi apply time so no machine-specific path is baked into the file.
if command -v brew >/dev/null 2>&1; then
  __brew_prefix="$(brew --prefix)"
  for __plugin in \
    "$__brew_prefix/share/zsh-autosuggestions/zsh-autosuggestions.zsh" \
    "$__brew_prefix/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"; do
    [[ -r "$__plugin" ]] && source "$__plugin"
  done
  unset __brew_prefix __plugin
fi
