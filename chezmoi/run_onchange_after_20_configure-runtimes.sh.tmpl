{{- if and (eq .chezmoi.os "darwin") (has "dev" .profiles) -}}
#!/usr/bin/env bash
set -Eeuo pipefail

{{ template "brew-shellenv" . }}

# mise provisions every declared runtime, including Rust: it drives rustup and
# installs rustup itself when absent, so no separate toolchain fix-up is needed.
if command -v mise >/dev/null 2>&1; then
  mise install
else
  echo "[WARN] mise is not installed; skipping runtime installation." >&2
fi
{{- end }}
