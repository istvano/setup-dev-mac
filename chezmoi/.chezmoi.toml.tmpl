{{- $gitName := promptStringOnce . "gitName" "Git user.name" -}}
{{- $gitEmail := promptStringOnce . "gitEmail" "Git user.email" -}}
{{- $gitSigningMethod := promptChoiceOnce . "gitSigningMethod" "Commit signing method" (list "gpg" "ssh" "none") "gpg" -}}
{{- $gitSigningKey := promptStringOnce . "gitSigningKey" "Signing key: GPG key ID, or SSH public key for the ssh method (empty to disable)" "" -}}
{{- $workGitDir := promptStringOnce . "workGitDir" "Directory holding work repositories" "~/work" -}}
{{- $workGitEmail := promptStringOnce . "workGitEmail" "Git user.email inside that directory (empty to disable the split)" "" -}}
{{- $profileChoices := list "core" "dev" "security" "security-extra" "security-scan" "backup" "local-llm" "lab" "docs" "fonts" "mcp" "cloud" "cloud-aws" "cloud-azure" "cloud-gcp" "kubernetes" "data" "productivity" "productivity-extra" "paid" -}}
{{- $profiles := promptMultichoiceOnce . "profiles" "Workstation profiles" $profileChoices (list "core" "dev" "security" "productivity" "backup" "kubernetes") -}}
{{- $shell := promptChoiceOnce . "shell" "Interactive shell (fish does not change the account login shell)" (list "zsh" "fish") "zsh" -}}
{{- $runtime := promptChoiceOnce . "runtime" "Container runtime" (list "colima" "rancher" "orbstack" "none") "colima" -}}
{{- $passwordManager := promptChoiceOnce . "passwordManager" "Password manager" (list "bitwarden" "1password" "none") "bitwarden" -}}
{{- $firewall := promptChoiceOnce . "firewall" "Outbound firewall" (list "lulu" "little-snitch" "none") "lulu" -}}
{{- /* Defaults to true, matching ./bootstrap. This prompt is only reached by a direct
       `chezmoi init` that bypassed bootstrap; bootstrap writes the value itself. */ -}}
{{- $applyMacOSDefaults := promptBoolOnce . "applyMacOSDefaults" "Apply conservative macOS defaults" true -}}
{{- /* .chezmoiroot resolves .chezmoi.sourceDir to <repo>/chezmoi. Record the
       repository root so this file agrees with what ./bootstrap writes. */ -}}
sourceDir = {{ dir .chezmoi.sourceDir | quote }}
[git]
autoCommit = false
autoPush = false
[diff]
# pager only, NOT command. `diff.command` makes chezmoi invoke the tool for
# INDIVIDUAL FILE differences, and delta spawns its own pager each time — so a
# multi-file diff opened a pager per file and could not be escaped. `diff.pager`
# is the one that pipes chezmoi's single unified diff through delta once, and it
# is what `chezmoi diff --no-pager` can then turn off.
pager = "delta"
[data]
gitName = {{ $gitName | quote }}
gitEmail = {{ $gitEmail | quote }}
gitSigningMethod = {{ $gitSigningMethod | quote }}
gitSigningKey = {{ $gitSigningKey | quote }}
workGitDir = {{ $workGitDir | quote }}
workGitEmail = {{ $workGitEmail | quote }}
profiles = {{ $profiles | toToml }}
shell = {{ $shell | quote }}
runtime = {{ $runtime | quote }}
passwordManager = {{ $passwordManager | quote }}
firewall = {{ $firewall | quote }}
applyMacOSDefaults = {{ $applyMacOSDefaults }}
