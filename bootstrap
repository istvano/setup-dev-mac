#!/usr/bin/env bash
# Strap-inspired trust bootstrap. The full workstation is managed by chezmoi.
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"
# shellcheck source=script/lib/profiles.sh
source "$ROOT/script/lib/profiles.sh"

COMMAND="plan"
PROFILES="$DEFAULT_PROFILES"
# Not named SHELL: that variable names the running shell and is read by other
# programs, so assigning to it here would misreport this process to everything
# bootstrap invokes.
SHELL_CHOICE="zsh"
RUNTIME="colima"
PASSWORD_MANAGER="bitwarden"
FIREWALL="lulu"
GIT_NAME="${GIT_AUTHOR_NAME:-}"
GIT_EMAIL="${GIT_AUTHOR_EMAIL:-}"
GIT_SIGNING_METHOD="gpg"
GIT_SIGNING_KEY=""
# The tilde is intentionally literal: this string is written to chezmoi data and
# ends up in a git `includeIf gitdir:` pattern, which git expands itself.
# shellcheck disable=SC2088
WORK_GIT_DIR="~/work"
WORK_GIT_EMAIL=""
# The macOS defaults and the firewall are on by default. Both were opt-in while they
# were unproven, which meant an install that forgot the flag produced an unhardened
# machine with none of the declared defaults — the failure mode is silent, and the
# whole point of a declarative workstation is that the declared state is what you get.
# Both are cheap and reversible: macos-defaults records every previous value before
# writing (see --diff and the macos-defaults-before.* transcript), and the firewall is
# two socketfilterfw calls. Opt out with --no-macos-defaults / --no-hardening.
#
# Touch ID for sudo and OS updates stay opt-in: the first edits /etc/pam.d/sudo_local
# and the second can reboot.
APPLY_MACOS_DEFAULTS=true
WITH_TOUCHID_SUDO=false
WITH_HARDENING=true
INSTALL_UPDATES=false
ASSUME_YES=0

usage() {
  cat <<'EOF'
Usage: ./bootstrap plan|install [options]
  --profiles LIST|all          'all' means every declared profile
  --shell zsh|fish
  --runtime colima|rancher|orbstack|none
  --password-manager bitwarden|1password|none
  --firewall lulu|little-snitch|none
  --git-name VALUE
  --git-email VALUE
  --git-signing-method gpg|ssh|none
  --git-signing-key VALUE      GPG key ID, or SSH public key for the ssh method
  --work-git-dir PATH          directory holding work repositories
  --work-git-email VALUE       Git identity used inside that directory
  --no-macos-defaults          skip the declared macOS defaults (applied by default)
  --no-hardening               leave the firewall alone (enabled by default)
  --with-macos-defaults        accepted and redundant; both are the default now
  --with-hardening             accepted and redundant; both are the default now
  --with-touchid-sudo          enable Touch ID for sudo via /etc/pam.d/sudo_local
  --install-updates
  --yes
EOF
}

parse_args() {
  if [[ $# -gt 0 && "$1" != -* ]]; then
    COMMAND="$1"
    shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Every value option is guarded by require_value (script/lib/common.sh). The
      # identity options need it most: they have no validator downstream, so an absorbed
      # flag used to reach ~/.gitconfig as the commit address and the run still reported
      # success.
      --profiles)
        require_value "$1" "${2:-}"
        PROFILES="$2"
        shift 2
        ;;
      --shell)
        require_value "$1" "${2:-}"
        SHELL_CHOICE="$2"
        shift 2
        ;;
      --runtime)
        require_value "$1" "${2:-}"
        RUNTIME="$2"
        shift 2
        ;;
      --password-manager)
        require_value "$1" "${2:-}"
        PASSWORD_MANAGER="$2"
        shift 2
        ;;
      --firewall)
        require_value "$1" "${2:-}"
        FIREWALL="$2"
        shift 2
        ;;
      --git-name)
        require_value "$1" "${2:-}"
        GIT_NAME="$2"
        shift 2
        ;;
      --git-email)
        require_value "$1" "${2:-}"
        GIT_EMAIL="$2"
        shift 2
        ;;
      --git-signing-method)
        require_value "$1" "${2:-}"
        GIT_SIGNING_METHOD="$2"
        shift 2
        ;;
      --git-signing-key)
        require_value "$1" "${2:-}"
        GIT_SIGNING_KEY="$2"
        shift 2
        ;;
      --work-git-dir)
        require_value "$1" "${2:-}"
        WORK_GIT_DIR="$2"
        shift 2
        ;;
      --work-git-email)
        require_value "$1" "${2:-}"
        WORK_GIT_EMAIL="$2"
        shift 2
        ;;
      # --with-* are kept rather than removed: they appear in this repository's own
      # docs, in evidence transcripts and in anything a reader copied from them, and
      # silently rejecting a flag that asks for the behaviour already in effect would
      # fail an install for no reason.
      --with-macos-defaults)
        APPLY_MACOS_DEFAULTS=true
        shift
        ;;
      --no-macos-defaults)
        APPLY_MACOS_DEFAULTS=false
        shift
        ;;
      --with-hardening)
        WITH_HARDENING=true
        shift
        ;;
      --no-hardening)
        WITH_HARDENING=false
        shift
        ;;
      --with-touchid-sudo)
        WITH_TOUCHID_SUDO=true
        shift
        ;;
      --install-updates)
        INSTALL_UPDATES=true
        shift
        ;;
      --yes | -y)
        ASSUME_YES=1
        export ASSUME_YES
        shift
        ;;
      --help | -h)
        COMMAND=help
        shift
        ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

# `--profiles all` means every declared profile.
#
# It expands from VALID_PROFILES rather than from a copied string, so a profile
# added later is selected without anyone editing a second list;
# tests/profiles.sh asserts that. What it expanded to is always printed, because a
# selection this broad should be visible in the plan rather than implied by a word.
#
# There is no longer an exclusion step. Every declared package installs on Apple
# Silicon, which is now the only supported platform (ADR-036).
expand_profile_selection() {
  [[ "$PROFILES" == all ]] || return 0
  local expanded="" profile
  for profile in "${VALID_PROFILES[@]}"; do
    expanded="${expanded:+$expanded,}$profile"
  done
  PROFILES="$expanded"
  log "--profiles all selected every profile (${#VALID_PROFILES[@]})."
}

validate_choices() {
  [[ "$COMMAND" =~ ^(plan|install|help)$ ]] || die "Unknown command: $COMMAND"
  expand_profile_selection
  validate_profiles "$PROFILES"
  [[ "$SHELL_CHOICE" =~ ^(zsh|fish)$ ]] || die "Invalid shell"
  [[ "$RUNTIME" =~ ^(colima|rancher|orbstack|none)$ ]] || die "Invalid runtime"
  [[ "$PASSWORD_MANAGER" =~ ^(bitwarden|1password|none)$ ]] || die "Invalid password manager"
  [[ "$FIREWALL" =~ ^(lulu|little-snitch|none)$ ]] || die "Invalid firewall"
  [[ "$GIT_SIGNING_METHOD" =~ ^(gpg|ssh|none)$ ]] || die "Invalid commit signing method"
}

print_plan() {
  # Naming the consequence in the plan, because "shell: fish" reads as a promise
  # that the account login shell changes, and it deliberately does not.
  local shell_note=""
  [[ "$SHELL_CHOICE" == fish ]] &&
    shell_note=" (Ghostty runs fish; the account login shell is unchanged)"
  cat <<EOF
Workstation bootstrap plan
  source repository:    $ROOT
  profiles:             $PROFILES
  interactive shell:    $SHELL_CHOICE$shell_note
  container runtime:    $RUNTIME
  password manager:     $PASSWORD_MANAGER
  outbound firewall:    $FIREWALL
  Git user.name:        ${GIT_NAME:-<prompt during install>}
  Git user.email:       ${GIT_EMAIL:-<prompt during install>}
  commit signing:       $GIT_SIGNING_METHOD
  Git signing key:      ${GIT_SIGNING_KEY:-<commit signing disabled>}
  work repositories:    $WORK_GIT_DIR
  work Git user.email:  ${WORK_GIT_EMAIL:-<no separate work identity>}
  macOS defaults:       $APPLY_MACOS_DEFAULTS
  security hardening:   $WITH_HARDENING
  Touch ID for sudo:    $WITH_TOUCHID_SUDO
  recommended updates:  $INSTALL_UPDATES

Bootstrap trust set:
  Xcode Command Line Tools, Homebrew, Git, GitHub CLI, age, git-delta and chezmoi

Your password is asked for once immediately after you confirm, so the early
privileged steps do not each prompt on their own. Expect ONE further prompt after
the packages install: the macOS defaults run then, well past sudo's timeout.
EOF
}

# Install the Command Line Tools without a GUI detour.
#
# This used to run `xcode-select --install` and then die: "Complete the Apple installer,
# then rerun". That made the FIRST `./bootstrap install` on a clean Mac always exit
# non-zero — the one command a new machine runs, failing by design, with the two-pass
# requirement recorded only in docs/TESTING.md, a maintainer document.
#
# `softwareupdate` can install the same package headlessly, but only when the on-demand
# sentinel file exists: without it the Command Line Tools package is not offered in the
# list at all. That is the trick script/test-install has used to provision guests since
# the VM harness was built, so it is well exercised here.
#
# The GUI path remains as a fallback. If softwareupdate offers nothing — a macOS version
# that changed the label, or a machine that already has full Xcode — the old behaviour is
# exactly right, so it is kept rather than replaced.
ensure_xcode_clt() {
  if xcode-select -p >/dev/null 2>&1; then
    success "Xcode Command Line Tools are installed."
    return
  fi

  local sentinel=/tmp/.com.apple.dt.CommandLineTools.installondemand.in-progress
  local label=''
  log "Installing the Xcode Command Line Tools. This needs sudo and takes a few minutes."
  sudo touch "$sentinel" 2>/dev/null || true
  label="$(softwareupdate -l 2>/dev/null |
    sed -n 's/^ *\* Label: \(Command Line Tools for Xcode.*\)$/\1/p' | tail -1)"

  if [[ -n "$label" ]]; then
    log "Installing: $label"
    if sudo softwareupdate -i "$label"; then
      sudo rm -f "$sentinel" 2>/dev/null || true
      # Read back rather than trusting the installer's exit status: /usr/bin/git and
      # /usr/bin/python3 are stubs until this is present, so a false success here surfaces
      # later as something unrelated.
      xcode-select -p >/dev/null 2>&1 ||
        die "softwareupdate reported success but xcode-select -p still fails."
      success "Xcode Command Line Tools are installed."
      return
    fi
  fi

  sudo rm -f "$sentinel" 2>/dev/null || true
  warn "softwareupdate could not install them; falling back to the Apple installer."
  xcode-select --install >/dev/null 2>&1 || true
  die "Complete the Apple installer, then rerun ./bootstrap install."
}

ensure_homebrew() {
  if activate_homebrew; then
    success "Homebrew is installed at $(brew_prefix)."
    return
  fi
  confirm "Install Homebrew from brew.sh?" || die "Homebrew is required."

  # The installer is fetched to disk and its digest shown before execution, so
  # the one remote script this repository runs can actually be reviewed. Piping
  # curl straight into bash would contradict the trust model in SECURITY.md.
  local installer
  installer="$(mktemp "${TMPDIR:-/tmp}/homebrew-install.XXXXXX.sh")"
  curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$installer"
  log "Downloaded the Homebrew installer to $installer"
  log "SHA-256: $(shasum -a 256 "$installer" | awk '{print $1}')"
  log "Review it in another terminal before continuing."
  confirm "Execute this Homebrew installer?" || {
    rm -f "$installer"
    die "Homebrew is required."
  }
  # NONINTERACTIVE is required for an unattended run, and only under --yes.
  #
  # The installer ends with `if [[ -z "${NONINTERACTIVE-}" ]]; then wait_for_user`,
  # which prints "Press RETURN/ENTER to continue" and reads one character. It sets
  # NONINTERACTIVE itself only when $CI is set or stdin is not a TTY — and
  # script/test-install reaches this over `ssh -t`, so there IS a tty and the prompt
  # appears. An unattended install therefore hung here with no indication why.
  #
  # Passed only when --yes was given, so an interactive install keeps the prompt.
  # That prompt is the last chance to stop after reviewing the digest printed above,
  # and suppressing it unconditionally would remove a deliberate review step from
  # the one remote script this repository executes (SECURITY.md).
  if [[ "$ASSUME_YES" == "1" ]]; then
    NONINTERACTIVE=1 /bin/bash "$installer"
  else
    /bin/bash "$installer"
  fi
  rm -f "$installer"
  # Discovered rather than assumed, through brew_prefix, so the prefix has exactly
  # one definition and it lives in script/lib/common.sh.
  activate_homebrew || die "Homebrew installed but no brew binary was found in
$(printf '%s ' "${HOMEBREW_PREFIXES[@]}")."
}

# Apple supports /etc/pam.d/sudo_local for exactly this purpose; it survives
# macOS updates, unlike editing /etc/pam.d/sudo directly. Opt-in only.
enable_touchid_sudo_if_requested() {
  [[ "$WITH_TOUCHID_SUDO" == true ]] || return 0
  local template=/etc/pam.d/sudo_local.template target=/etc/pam.d/sudo_local

  if [[ -f "$target" ]] && grep -q '^auth[[:space:]]*sufficient[[:space:]]*pam_tid.so' "$target"; then
    success "Touch ID for sudo is already enabled."
    return 0
  fi
  [[ -f "$template" ]] || {
    warn "$template is missing; this macOS version does not support sudo_local."
    return 0
  }

  # An existing sudo_local is preserved before it is replaced.
  #
  # The check above only recognises `auth sufficient pam_tid.so`. Anything else in this
  # file — `auth required pam_tid.so`, pam_watchid.so, or a pam_reattach line ordered for
  # tmux without the pam_tid line matching that exact form — was replaced wholesale by the
  # stock two-line template with no copy kept, and the loss was silent: sudo simply stopped
  # behaving the way the user had configured it. AGENTS.md requires backing up user-owned
  # files before replacement, and backup_file cannot be used here because /etc is not
  # writable as the user, so the copy is made with sudo alongside the original.
  local backup=""
  if [[ -f "$target" ]]; then
    warn "$target already exists and does not contain 'auth sufficient pam_tid.so'.
It will be replaced by the stock template and a copy kept alongside it. If it carried
pam_reattach, pam_watchid or a different pam_tid form, merge that back afterwards."
  fi

  # After the prompt, not before: declining must leave nothing behind.
  confirm "Enable Touch ID for sudo by writing $target?" || return 0
  if [[ -f "$target" ]]; then
    backup="$target.replaced-by-bootstrap.$(date -u +%Y%m%d-%H%M%S)"
    sudo cp -p "$target" "$backup" ||
      die "Could not back up $target; refusing to replace it."
    log "Saved the previous $target as $backup"
  fi
  sudo cp "$template" "$target"
  sudo sed -i '' 's/^#auth/auth/' "$target"
  success "Enabled Touch ID for sudo in $target."
  [[ -z "$backup" ]] || log "Previous configuration: $backup"
}

# git-delta is part of the trust set because the chezmoi configuration selects it
# as the diff pager, so `chezmoi diff` fails without it before packages install.
install_bootstrap_packages() {
  require_writable_homebrew
  brew install git gh age chezmoi git-delta
}

apply_strap_inspired_security() {
  defaults write com.apple.screensaver askForPassword -int 1
  defaults write com.apple.screensaver askForPasswordDelay -int 0
  if [[ "$WITH_HARDENING" == true ]]; then
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on
  fi
  fdesetup status 2>/dev/null || true
  warn "FileVault is not enabled automatically. Enable it manually and store the recovery key offline."
  warn "No network service is enabled by this repository."
}

install_macos_updates_if_requested() {
  [[ "$INSTALL_UPDATES" == true ]] || return 0
  confirm "Install currently recommended macOS updates now?" || return 0
  sudo softwareupdate --install --recommended
}

prompt_identity() {
  # `read` returns non-zero at end of input, and as the last command of an `||`
  # list that failure is not exempt from errexit: the script exited immediately
  # with status 1 and the die below never ran. A bootstrap driven from anything
  # other than a keyboard therefore failed with no output whatsoever, which is
  # the least diagnosable result available. The reads are now allowed to fail so
  # the check underneath is what reports.
  if [[ -z "$GIT_NAME" ]]; then
    read -r -p "Git user.name: " GIT_NAME || GIT_NAME=""
  fi
  if [[ -z "$GIT_EMAIL" ]]; then
    read -r -p "Git user.email: " GIT_EMAIL || GIT_EMAIL=""
  fi
  [[ -n "$GIT_NAME" && -n "$GIT_EMAIL" ]] || die "Git user.name and user.email are required.
They were not supplied and could not be read from the terminal. Pass them
directly, which is also what a non-interactive run needs:
  ./bootstrap install --git-name \"Your Name\" --git-email you@example.com ..."
}

toml_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

# Machine identity, mirroring chezmoi/.chezmoi.toml.tmpl.
#
# scutil rather than `hostname`: on macOS `hostname` reflects whatever the current network
# hands back and changes with the Wi-Fi, so it cannot be a stable key for per-machine
# configuration. ComputerName is what System Settings shows and what stays put.
#
# Both this and the template write these keys, which is the duplication TASKS.md already
# records for the other twelve. Kept consistent by tests/placement-policy.sh until the two
# writers are collapsed into one.
machine_name() {
  scutil --get ComputerName 2>/dev/null || hostname -s 2>/dev/null || echo unknown
}

# Detected, never asked. A CI runner or a container has nobody to answer a prompt, and
# templates use this to skip GUI casks, secrets and macOS defaults rather than needing a
# separate code path for those hosts.
is_ephemeral() {
  if [[ -n "${CI:-}" || -n "${CODESPACES:-}" ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

write_chezmoi_config() {
  # Separate declarations: bash expands every argument to `local` before the
  # builtin assigns any of them, so a later value cannot reference an earlier one.
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi"
  local config="$config_dir/chezmoi.toml"
  local profiles_toml="" profile profile_array
  IFS=',' read -r -a profile_array <<<"$PROFILES"
  for profile in "${profile_array[@]}"; do
    [[ -n "$profiles_toml" ]] && profiles_toml+=", "
    profiles_toml+="$(toml_quote "$profile")"
  done
  mkdir -p "$config_dir"
  [[ -e "$config" ]] && backup_file "$config"
  # A SUBSHELL, not a bare `umask 077`. The umask builtin changes the process,
  # not the block, so setting it here leaked into everything main() runs next —
  # including `chezmoi init --apply`, whose first hook is `brew bundle install`
  # for the whole selection. Both shell configurations in this repository already
  # record why that is wrong: "Homebrew fails to build several formulae under
  # umask 077." A first install could therefore lose packages to the umask this
  # function set, and hook 10 reports a failed package install and continues, so
  # the cause was two steps removed from the symptom.
  #
  # The umask is still needed: it closes the window between creating the file and
  # the chmod below, during which the config holds the Git identity at whatever
  # the inherited umask allowed. Scoping it to a subshell keeps that guarantee
  # without exporting it to the rest of the bootstrap.
  (
    umask 077
    cat >"$config" <<EOF
sourceDir = $(toml_quote "$ROOT")

[git]
autoCommit = false
autoPush = false

[diff]
# pager only, NOT command. Setting diff.command makes chezmoi invoke the tool for
# INDIVIDUAL FILE differences, and delta spawns its own pager each time, so a
# multi-file diff opened a pager per file and could not be escaped. diff.pager is
# the one that pipes chezmoi's single unified diff through delta once, and it is
# what "chezmoi diff --no-pager" can then turn off.
#
# No backticks in this block: it is written by an unquoted heredoc, where they
# would be command substitution rather than punctuation.
pager = "delta"

[data]
gitName = $(toml_quote "$GIT_NAME")
gitEmail = $(toml_quote "$GIT_EMAIL")
gitSigningMethod = $(toml_quote "$GIT_SIGNING_METHOD")
gitSigningKey = $(toml_quote "$GIT_SIGNING_KEY")
workGitDir = $(toml_quote "$WORK_GIT_DIR")
workGitEmail = $(toml_quote "$WORK_GIT_EMAIL")
profiles = [$profiles_toml]
shell = $(toml_quote "$SHELL_CHOICE")
runtime = $(toml_quote "$RUNTIME")
passwordManager = $(toml_quote "$PASSWORD_MANAGER")
firewall = $(toml_quote "$FIREWALL")
applyMacOSDefaults = $APPLY_MACOS_DEFAULTS
machineName = $(toml_quote "$(machine_name)")
ephemeral = $(is_ephemeral)
EOF
    chmod 600 "$config"
  )
}

# Ask for the password once, at a predictable moment, instead of three times at random ones.
#
# Several early steps need sudo — the Command Line Tools installer, the Homebrew installer,
# the application firewall — and each used to prompt on its own whenever its turn came.
# Priming the timestamp collapses them into one prompt right after you have agreed to
# proceed, which is also the moment you are still watching.
#
# What this does NOT fix, deliberately: apply hook 40 runs `macos-defaults apply` after
# `brew bundle` has spent 30-45 minutes installing packages, which is many times sudo's
# five-minute timestamp, so that prompt still arrives mid-run. A background keepalive would
# suppress it by holding root authority unattended for the whole install — which is a worse
# trade than one expected prompt, and contradicts the posture SECURITY.md takes about
# privileged operations. docs/NEW-MACHINE.md warns the operator that it is coming.
#
# SECURITY.md and docs/TESTING.md already tell the operator to run `sudo -v` by hand before
# recording a session, so that a password is never captured in a transcript. This makes the
# code do what the documentation asked for.
#
# Non-fatal: a machine with passwordless sudo, or an operator who declines, should not lose
# the run here. The individual sudo calls will prompt or fail on their own terms.
prime_sudo() {
  # NOPASSWD is checked FIRST, because `sudo -v` does not honour it.
  #
  # Measured in the test guest, which has `NOPASSWD: ALL`: `sudo -n true` exits 0 while
  # `sudo -n -v` fails with "a password is required". `-v` refreshes the credential
  # timestamp, and that is a password operation regardless of what the command rules say.
  # So on a passwordless machine the old order always fell through to the warning — and the
  # warning was itself wrong there, promising prompts that will never come.
  if sudo -n true 2>/dev/null; then
    log "sudo needs no password on this machine; nothing to pre-authorise."
    return 0
  fi

  if sudo -v; then
    log "sudo authorised; the early privileged steps will not prompt again."
    return 0
  fi

  # Reached when the operator declines, or there is no terminal to ask on. Not fatal: the
  # steps that need sudo will ask, or fail, on their own terms — which is a better outcome
  # than aborting an install over a convenience.
  warn "Not pre-authorised. Individual privileged steps will prompt as they need it."
}

main() {
  parse_args "$@"
  validate_choices
  [[ "$COMMAND" == help ]] && {
    usage
    exit 0
  }
  print_plan
  [[ "$COMMAND" == plan ]] && exit 0
  require_supported_mac
  confirm "Proceed with bootstrap and chezmoi apply?" || die "Cancelled."
  prime_sudo
  ensure_xcode_clt
  ensure_homebrew
  install_bootstrap_packages
  prompt_identity
  apply_strap_inspired_security
  enable_touchid_sudo_if_requested
  install_macos_updates_if_requested
  write_chezmoi_config
  chezmoi init --source "$ROOT" --apply
  success "Bootstrap completed."
}

main "$@"
