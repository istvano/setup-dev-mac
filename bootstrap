#!/usr/bin/env bash
# Strap-inspired trust bootstrap. The full workstation is managed by chezmoi.
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"
# shellcheck source=script/lib/profiles.sh
source "$ROOT/script/lib/profiles.sh"

COMMAND="plan"
PROFILES="$DEFAULT_PROFILES"
RUNTIME="rancher"
PASSWORD_MANAGER="bitwarden"
FIREWALL="lulu"
GIT_NAME="${GIT_AUTHOR_NAME:-}"
GIT_EMAIL="${GIT_AUTHOR_EMAIL:-}"
GIT_SIGNING_METHOD="gpg"
GIT_SIGNING_KEY=""
# The tilde is intentionally literal: this string is written to chezmoi data and
# ends up in a git `includeIf gitdir:` pattern, which git expands itself.
# shellcheck disable=SC2088
WORK_GIT_DIR="~/work"
WORK_GIT_EMAIL=""
APPLY_MACOS_DEFAULTS=false
WITH_TOUCHID_SUDO=false
WITH_HARDENING=false
INSTALL_UPDATES=false
ASSUME_YES=0

usage() {
  cat <<'EOF'
Usage: ./bootstrap plan|install [options]
  --profiles LIST
  --runtime rancher|orbstack|colima|none
  --password-manager bitwarden|1password|none
  --firewall lulu|little-snitch|none
  --git-name VALUE
  --git-email VALUE
  --git-signing-method gpg|ssh|none
  --git-signing-key VALUE      GPG key ID, or SSH public key for the ssh method
  --work-git-dir PATH          directory holding work repositories
  --work-git-email VALUE       Git identity used inside that directory
  --with-macos-defaults
  --with-hardening
  --with-touchid-sudo          enable Touch ID for sudo via /etc/pam.d/sudo_local
  --install-updates
  --yes
EOF
}

parse_args() {
  if [[ $# -gt 0 && "$1" != -* ]]; then
    COMMAND="$1"
    shift
  fi
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profiles)
        PROFILES="$2"
        shift 2
        ;;
      --runtime)
        RUNTIME="$2"
        shift 2
        ;;
      --password-manager)
        PASSWORD_MANAGER="$2"
        shift 2
        ;;
      --firewall)
        FIREWALL="$2"
        shift 2
        ;;
      --git-name)
        GIT_NAME="$2"
        shift 2
        ;;
      --git-email)
        GIT_EMAIL="$2"
        shift 2
        ;;
      --git-signing-method)
        GIT_SIGNING_METHOD="$2"
        shift 2
        ;;
      --git-signing-key)
        GIT_SIGNING_KEY="$2"
        shift 2
        ;;
      --work-git-dir)
        WORK_GIT_DIR="$2"
        shift 2
        ;;
      --work-git-email)
        WORK_GIT_EMAIL="$2"
        shift 2
        ;;
      --with-macos-defaults)
        APPLY_MACOS_DEFAULTS=true
        shift
        ;;
      --with-hardening)
        WITH_HARDENING=true
        shift
        ;;
      --with-touchid-sudo)
        WITH_TOUCHID_SUDO=true
        shift
        ;;
      --install-updates)
        INSTALL_UPDATES=true
        shift
        ;;
      --yes | -y)
        ASSUME_YES=1
        export ASSUME_YES
        shift
        ;;
      --help | -h)
        COMMAND=help
        shift
        ;;
      *) die "Unknown option: $1" ;;
    esac
  done
}

validate_choices() {
  [[ "$COMMAND" =~ ^(plan|install|help)$ ]] || die "Unknown command: $COMMAND"
  validate_profiles "$PROFILES"
  [[ "$RUNTIME" =~ ^(rancher|orbstack|colima|none)$ ]] || die "Invalid runtime"
  [[ "$PASSWORD_MANAGER" =~ ^(bitwarden|1password|none)$ ]] || die "Invalid password manager"
  [[ "$FIREWALL" =~ ^(lulu|little-snitch|none)$ ]] || die "Invalid firewall"
  [[ "$GIT_SIGNING_METHOD" =~ ^(gpg|ssh|none)$ ]] || die "Invalid commit signing method"
}

print_plan() {
  cat <<EOF
Workstation bootstrap plan
  source repository:    $ROOT
  profiles:             $PROFILES
  container runtime:    $RUNTIME
  password manager:     $PASSWORD_MANAGER
  outbound firewall:    $FIREWALL
  Git user.name:        ${GIT_NAME:-<prompt during install>}
  Git user.email:       ${GIT_EMAIL:-<prompt during install>}
  commit signing:       $GIT_SIGNING_METHOD
  Git signing key:      ${GIT_SIGNING_KEY:-<commit signing disabled>}
  work repositories:    $WORK_GIT_DIR
  work Git user.email:  ${WORK_GIT_EMAIL:-<no separate work identity>}
  macOS defaults:       $APPLY_MACOS_DEFAULTS
  security hardening:   $WITH_HARDENING
  Touch ID for sudo:    $WITH_TOUCHID_SUDO
  recommended updates:  $INSTALL_UPDATES

Bootstrap trust set:
  Xcode Command Line Tools, Homebrew, Git, GitHub CLI, age, git-delta and chezmoi
EOF
}

ensure_xcode_clt() {
  if xcode-select -p >/dev/null 2>&1; then
    success "Xcode Command Line Tools are installed."
    return
  fi
  log "Starting the Apple Xcode Command Line Tools installer."
  xcode-select --install >/dev/null 2>&1 || true
  die "Complete the Apple installer, then rerun ./bootstrap install."
}

ensure_homebrew() {
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    success "Homebrew is installed."
    return
  fi
  confirm "Install Homebrew from brew.sh?" || die "Homebrew is required."

  # The installer is fetched to disk and its digest shown before execution, so
  # the one remote script this repository runs can actually be reviewed. Piping
  # curl straight into bash would contradict the trust model in SECURITY.md.
  local installer
  installer="$(mktemp "${TMPDIR:-/tmp}/homebrew-install.XXXXXX.sh")"
  curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh -o "$installer"
  log "Downloaded the Homebrew installer to $installer"
  log "SHA-256: $(shasum -a 256 "$installer" | awk '{print $1}')"
  log "Review it in another terminal before continuing."
  confirm "Execute this Homebrew installer?" || {
    rm -f "$installer"
    die "Homebrew is required."
  }
  /bin/bash "$installer"
  rm -f "$installer"
  eval "$(/opt/homebrew/bin/brew shellenv)"
}

# Apple supports /etc/pam.d/sudo_local for exactly this purpose; it survives
# macOS updates, unlike editing /etc/pam.d/sudo directly. Opt-in only.
enable_touchid_sudo_if_requested() {
  [[ "$WITH_TOUCHID_SUDO" == true ]] || return 0
  local template=/etc/pam.d/sudo_local.template target=/etc/pam.d/sudo_local

  if [[ -f "$target" ]] && grep -q '^auth[[:space:]]*sufficient[[:space:]]*pam_tid.so' "$target"; then
    success "Touch ID for sudo is already enabled."
    return 0
  fi
  [[ -f "$template" ]] || {
    warn "$template is missing; this macOS version does not support sudo_local."
    return 0
  }

  confirm "Enable Touch ID for sudo by writing $target?" || return 0
  sudo cp "$template" "$target"
  sudo sed -i '' 's/^#auth/auth/' "$target"
  success "Enabled Touch ID for sudo in $target."
}

# git-delta is part of the trust set because the chezmoi configuration selects it
# as the diff pager, so `chezmoi diff` fails without it before packages install.
install_bootstrap_packages() { brew install git gh age chezmoi git-delta; }

apply_strap_inspired_security() {
  defaults write com.apple.screensaver askForPassword -int 1
  defaults write com.apple.screensaver askForPasswordDelay -int 0
  if [[ "$WITH_HARDENING" == true ]]; then
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on
    sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on
  fi
  fdesetup status 2>/dev/null || true
  warn "FileVault is not enabled automatically. Enable it manually and store the recovery key offline."
  warn "No network service is enabled by this repository."
}

install_macos_updates_if_requested() {
  [[ "$INSTALL_UPDATES" == true ]] || return 0
  confirm "Install currently recommended macOS updates now?" || return 0
  sudo softwareupdate --install --recommended
}

prompt_identity() {
  [[ -n "$GIT_NAME" ]] || read -r -p "Git user.name: " GIT_NAME
  [[ -n "$GIT_EMAIL" ]] || read -r -p "Git user.email: " GIT_EMAIL
  [[ -n "$GIT_NAME" && -n "$GIT_EMAIL" ]] || die "Git name and email are required."
}

toml_quote() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '"%s"' "$value"
}

write_chezmoi_config() {
  # Separate declarations: bash expands every argument to `local` before the
  # builtin assigns any of them, so a later value cannot reference an earlier one.
  local config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi"
  local config="$config_dir/chezmoi.toml"
  local profiles_toml="" profile
  IFS=',' read -r -a profile_array <<<"$PROFILES"
  for profile in "${profile_array[@]}"; do
    [[ -n "$profiles_toml" ]] && profiles_toml+=", "
    profiles_toml+="$(toml_quote "$profile")"
  done
  mkdir -p "$config_dir"
  [[ -e "$config" ]] && backup_file "$config"
  umask 077
  cat >"$config" <<EOF
sourceDir = $(toml_quote "$ROOT")

[git]
autoCommit = false
autoPush = false

[diff]
command = "delta"
pager = "delta"

[data]
gitName = $(toml_quote "$GIT_NAME")
gitEmail = $(toml_quote "$GIT_EMAIL")
gitSigningMethod = $(toml_quote "$GIT_SIGNING_METHOD")
gitSigningKey = $(toml_quote "$GIT_SIGNING_KEY")
workGitDir = $(toml_quote "$WORK_GIT_DIR")
workGitEmail = $(toml_quote "$WORK_GIT_EMAIL")
profiles = [$profiles_toml]
runtime = $(toml_quote "$RUNTIME")
passwordManager = $(toml_quote "$PASSWORD_MANAGER")
firewall = $(toml_quote "$FIREWALL")
applyMacOSDefaults = $APPLY_MACOS_DEFAULTS
EOF
  chmod 600 "$config"
}

main() {
  parse_args "$@"
  validate_choices
  [[ "$COMMAND" == help ]] && {
    usage
    exit 0
  }
  print_plan
  [[ "$COMMAND" == plan ]] && exit 0
  require_macos_arm64
  confirm "Proceed with bootstrap and chezmoi apply?" || die "Cancelled."
  ensure_xcode_clt
  ensure_homebrew
  install_bootstrap_packages
  prompt_identity
  apply_strap_inspired_security
  enable_touchid_sudo_if_requested
  install_macos_updates_if_requested
  write_chezmoi_config
  chezmoi init --source "$ROOT" --apply
  success "Bootstrap completed."
}

main "$@"
