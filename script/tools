#!/usr/bin/env bash
# Render the tool catalogue from the Brewfile fragments.
#
# GENERATED, not written. Every declared package already carries a purpose comment —
# `tests/render-brewfile.sh` rejects any entry without one — so the catalogue can be
# derived from the same lines Homebrew reads. A hand-maintained table would be a second
# place to update and the first place to go stale.
#
#   tools            print the catalogue to stdout
#   tools --write    write docs/TOOLS.md
#   tools --check    non-zero when docs/TOOLS.md is out of date
#
# --check is what keeps the committed file honest: adding a package without regenerating
# fails the suite, so the documentation cannot drift away from the declarations.
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"
# shellcheck source=script/lib/profiles.sh
source "$ROOT/script/lib/profiles.sh"

TARGET="$ROOT/docs/TOOLS.md"
MODE="print"

usage() {
  cat <<'EOF'
Usage: script/tools [--write|--check]

  (no argument)  print the catalogue to stdout
  --write        write docs/TOOLS.md
  --check        non-zero when docs/TOOLS.md does not match the declarations
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --write) MODE="write" ;;
    --check) MODE="check" ;;
    --help | -h)
      usage
      exit 0
      ;;
    *) die "Unknown option: $1" ;;
  esac
  shift
done

# The default alternatives, which are selected by their own flags rather than by the
# profile list, so VALID_PROFILES does not contain them.
DEFAULT_ALTERNATIVES=(shell-zsh runtime-colima password-bitwarden firewall-lulu)

# One profile per line, split on the COMMA that actually separates them.
#
# `for p in ${DEFAULT_PROFILES//,/ }` is the obvious idiom and is wrong here: it turns
# commas into spaces and then relies on IFS to split on space, but this file sets
# IFS=$'\n\t' like every script in the repository. The list arrived as a single word,
# so no profile matched, every default was filed under "opt-in", and the default total
# counted only the four alternatives — 9 instead of 68. tests/profiles.sh gets away with
# the same idiom because it does not set IFS.
default_profiles() {
  local IFS=','
  local profile
  for profile in $DEFAULT_PROFILES; do
    printf '%s\n' "$profile"
  done
}

is_default_profile() {
  local candidate="$1" profile
  while IFS= read -r profile; do
    [[ "$profile" == "$candidate" ]] && return 0
  done < <(default_profiles)
  for profile in "${DEFAULT_ALTERNATIVES[@]}"; do
    [[ "$profile" == "$candidate" ]] && return 0
  done
  return 1
}

# One table per fragment. awk rather than a shell loop because the purpose comment is a
# field split, and rather than python3 because /usr/bin/python3 is a stub until the
# Command Line Tools are installed (see script/lib/common.sh).
emit_table() {
  local fragment="$1"
  awk -F'"' '
    /^(brew|cask) "/ {
      name = $2
      rest = $0
      sub(/^[^#]*#[[:space:]]*/, "", rest)
      kind = ($0 ~ /^cask /) ? "cask" : "formula"
      printf "| `%s` | %s | %s |\n", name, rest, kind
    }
  ' "$fragment"
}

count_entries() {
  grep -cE '^(brew|cask) "' "$1" 2>/dev/null || printf '0'
}

# shellcheck disable=SC2016
emit_profile() {
  local profile="$1"
  local fragment="$ROOT/profiles/$profile.Brewfile"
  local count
  [[ -f "$fragment" ]] || return 0
  count="$(count_entries "$fragment")"
  [[ "$count" != 0 ]] || return 0
  printf '### `%s` — %s package(s)\n\n' "$profile" "$count"
  printf '| Tool | What it is for | Kind |\n|---|---|---|\n'
  emit_table "$fragment"
  printf '\n'
}

# shellcheck disable=SC2016
# The single quotes below hold markdown backticks, not shell expansions.
render() {
  local profile total_default=0 total_all=0 fragment

  cat <<'HEADER'
# Tool catalogue

Every package this repository can install, and what it is for.

**Generated by `script/tools`; do not edit.** The descriptions are the purpose comments
in `profiles/*.Brewfile`, which is where they belong — one place to change, and
`tests/render-brewfile.sh` already refuses an entry that has none. `script/tools
--check` fails when this file no longer matches the declarations, so it cannot drift.

Kind matters for review: a `formula` is normally a single binary, while a `cask`
installs an application that may carry a background component, a system extension or
its own updater. ADR-013 and ADR-015 weigh those differently.

HEADER

  printf '## Default selection\n\n'
  printf 'Installed by `./bootstrap install` with no `--profiles` argument.\n\n'
  while IFS= read -r profile; do
    emit_profile "$profile"
  done < <(default_profiles)
  printf '### Default alternatives\n\n'
  printf 'Mutually exclusive choices, selected by their own flags. These are the\n'
  printf 'defaults; see `./bootstrap --help` for the alternatives.\n\n'
  for profile in "${DEFAULT_ALTERNATIVES[@]}"; do
    emit_profile "$profile"
  done

  printf '## Opt-in profiles\n\n'
  printf 'Selected explicitly with `--profiles`. Nothing here is installed by default.\n\n'
  for profile in "${VALID_PROFILES[@]}"; do
    is_default_profile "$profile" && continue
    emit_profile "$profile"
  done

  printf '## Alternative runtimes, password managers and firewalls\n\n'
  printf 'Chosen instead of the defaults above, never alongside them.\n\n'
  for fragment in "$ROOT"/profiles/{shell,runtime,password,firewall}-*.Brewfile; do
    profile="$(basename "$fragment" .Brewfile)"
    is_default_profile "$profile" && continue
    emit_profile "$profile"
  done

  # Counted from the fragments rather than asserted, so the totals cannot disagree with
  # the tables above them.
  while IFS= read -r profile; do
    total_default=$((total_default + $(count_entries "$ROOT/profiles/$profile.Brewfile")))
  done < <(default_profiles)
  for profile in "${DEFAULT_ALTERNATIVES[@]}"; do
    total_default=$((total_default + $(count_entries "$ROOT/profiles/$profile.Brewfile")))
  done
  for fragment in "$ROOT"/profiles/*.Brewfile; do
    total_all=$((total_all + $(count_entries "$fragment")))
  done

  printf '## Totals\n\n'
  printf '| | Packages |\n|---|---|\n'
  printf '| Default selection | %s |\n' "$total_default"
  printf '| Everything declared | %s |\n' "$total_all"
  printf '\n'
  printf 'Language runtimes are not here: Node, Go, Java, Rust and pnpm come from mise\n'
  printf 'and Python from uv, so they are declared in `chezmoi/dot_config/mise/`\n'
  printf 'rather than as Homebrew packages (ADR-021).\n'
}

case "$MODE" in
  print) render ;;
  write)
    render >"$TARGET"
    success "Wrote $TARGET"
    ;;
  check)
    if diff -u "$TARGET" <(render) >/dev/null 2>&1; then
      success "docs/TOOLS.md matches the declarations."
    else
      warn 'docs/TOOLS.md is out of date:'
      diff -u "$TARGET" <(render) | head -40 >&2 || true
      die 'Regenerate it with ./script/tools --write'
    fi
    ;;
esac
