#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"
# shellcheck source=script/lib/profiles.sh
source "$ROOT/script/lib/profiles.sh"
PROFILES="$DEFAULT_PROFILES"
# See bootstrap: SHELL names the running shell, so the selection needs its own name.
SHELL_CHOICE="zsh"
RUNTIME="colima"
PASSWORD_MANAGER="bitwarden"
FIREWALL="lulu"
OUTPUT="${XDG_CONFIG_HOME:-$HOME/.config}/security-ai-workstation/Brewfile"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profiles)
      PROFILES="$2"
      shift 2
      ;;
    --shell)
      SHELL_CHOICE="$2"
      shift 2
      ;;
    --runtime)
      RUNTIME="$2"
      shift 2
      ;;
    --password-manager)
      PASSWORD_MANAGER="$2"
      shift 2
      ;;
    --firewall)
      FIREWALL="$2"
      shift 2
      ;;
    --output)
      OUTPUT="$2"
      shift 2
      ;;
    *) die "Unknown option: $1" ;;
  esac
done
[[ "$SHELL_CHOICE" =~ ^(zsh|fish)$ ]] || die "Invalid shell"
[[ "$RUNTIME" =~ ^(colima|rancher|orbstack|none)$ ]] || die "Invalid runtime"
[[ "$PASSWORD_MANAGER" =~ ^(bitwarden|1password|none)$ ]] || die "Invalid password manager"
[[ "$FIREWALL" =~ ^(lulu|little-snitch|none)$ ]] || die "Invalid firewall"
validate_profiles "$PROFILES"
fragments=()
IFS=',' read -r -a requested_profiles <<<"$PROFILES"
for profile in "${requested_profiles[@]}"; do
  fragments+=("$ROOT/profiles/$profile.Brewfile")
done
# The shell fragment has no `none`: a workstation always has an interactive shell.
fragments+=("$ROOT/profiles/shell-$SHELL_CHOICE.Brewfile")
[[ "$RUNTIME" != none ]] && fragments+=("$ROOT/profiles/runtime-$RUNTIME.Brewfile")
[[ "$PASSWORD_MANAGER" != none ]] && fragments+=("$ROOT/profiles/password-$PASSWORD_MANAGER.Brewfile")
[[ "$FIREWALL" != none ]] && fragments+=("$ROOT/profiles/firewall-$FIREWALL.Brewfile")
for fragment in "${fragments[@]}"; do [[ -f "$fragment" ]] || die "Missing fragment: $fragment"; done
{
  printf '# Generated from reviewed profile fragments. Do not edit directly.\n'
  printf '# Profiles: %s\n' "$PROFILES"
  printf '# Shell: %s; runtime: %s; password manager: %s; firewall: %s\n\n' \
    "$SHELL_CHOICE" "$RUNTIME" "$PASSWORD_MANAGER" "$FIREWALL"
  for fragment in "${fragments[@]}"; do
    printf '# ---- %s ----\n' "$(basename "$fragment")"
    cat "$fragment"
    printf '\n'
  done
} | atomic_write "$OUTPUT"
success "Rendered $OUTPUT"
