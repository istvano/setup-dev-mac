#!/usr/bin/env bash
# Push this working tree to the macOS test VM and optionally run a command there.
#
# Cloning is not an option, and the reason survived the move to a local VM
# unchanged: a pristine macOS guest has no git at all until the Xcode Command Line
# Tools are installed, which is the very thing under test. The working tree goes
# over ssh instead.
#
#   sync-to-mac                       sync only
#   sync-to-mac ./script/test         sync, then run that in the remote checkout
#   sync-to-mac --dry-run             list what would transfer, change nothing
#   sync-to-mac --fetch REMOTE LOCAL  copy a path back off the VM
#
# By default the target is the local macOS VM managed by script/vm, which is how
# this repository is tested (ADR-036). No address is hardcoded: script/vm resolves
# the guest's address and writes the SSH configuration used to reach it.
#
# A remote Mac still works, and overrides the local VM when named. AGENTS.md
# forbids machine-specific addresses in tracked files, so that comes from the
# environment and is never guessed:
#
#   export MAC_TEST_HOST=user@host
#   export MAC_TEST_PORT=22220
#   export MAC_TEST_DIR=workspace/mac-os-setup   # optional, relative to ~
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"

HOST="${MAC_TEST_HOST:-}"
PORT="${MAC_TEST_PORT:-22}"
# Relative to the remote home. Keep it stable: ./bootstrap writes this path into
# sourceDir in ~/.config/chezmoi/chezmoi.toml, and every apply hook builds
# repository script paths from it, so moving it later breaks them.
REMOTE_DIR="${MAC_TEST_DIR:-workspace/mac-os-setup}"

DRY_RUN=false
FETCH=false

usage() {
  cat <<'EOF'
Usage: script/sync-to-mac [--dry-run] [command...]
       script/sync-to-mac --fetch REMOTE_PATH LOCAL_PATH

  (no arguments)   sync the working tree to the VM and verify it arrived intact
  command...       sync, then run the command in the remote checkout
  --dry-run        list what would transfer, change nothing
  --fetch          copy a path back off the VM, for recording results

Environment:
  MAC_TEST_HOST    optional, e.g. user@host. Unset means the local macOS VM
                   managed by script/vm.
  MAC_TEST_PORT    default 22; ignored for the local VM
  MAC_TEST_DIR     default workspace/mac-os-setup, relative to the remote home
EOF
}

case "${1:-}" in
  --help | -h)
    usage
    exit 0
    ;;
  --dry-run)
    DRY_RUN=true
    shift
    ;;
  --fetch)
    FETCH=true
    shift
    ;;
esac

# Two targets, one transfer path. The local VM is reached through the SSH
# configuration script/vm generates, which carries the guest's address, the
# identity file and the host-key handling a VM that is re-cloned on every reset
# needs. A named remote host keeps the original port-and-address form.
#
# SSH_ARGS is an ARRAY, and SSH_COMMAND a separately built string for rsync's -e.
# Not one converted into the other: this file sets IFS=$'\n\t', so "${SSH_ARGS[*]}"
# would join on a newline and rsync would receive one unusable argument.
SSH_ARGS=()
SSH_COMMAND=""
if [[ -n "$HOST" ]]; then
  SSH_ARGS=(-p "$PORT")
  SSH_COMMAND="ssh -p $PORT"
  log "Target: $HOST (MAC_TEST_HOST)"
else
  vm_ssh_config="$("$ROOT/script/vm" ssh-config)"
  [[ -f "$vm_ssh_config" ]] || die "No local VM is up, and MAC_TEST_HOST is not set.
Start the test VM first, or name a remote Mac:
  ./script/vm up
  export MAC_TEST_HOST=user@host"
  # rsync word-splits the -e string on spaces itself, so a path containing one
  # cannot be passed through it. Refused rather than mangled, the same way
  # script/shell-files refuses a script path with whitespace.
  case "$vm_ssh_config" in
    *[[:space:]]*)
      die "The generated SSH configuration path contains whitespace, which rsync
cannot be given through -e: $vm_ssh_config"
      ;;
  esac
  HOST="workstation-vm"
  SSH_ARGS=(-F "$vm_ssh_config")
  SSH_COMMAND="ssh -F $vm_ssh_config"
  log "Target: the local macOS VM via $vm_ssh_config"
fi

# Client-side expansion is the point, not an oversight. Callers pass a pre-composed
# string such as "test -d '$REMOTE_DIR/.git'", where REMOTE_DIR is a LOCAL variable
# that must be resolved here — the guest has no such variable. shellcheck cannot
# tell that from the array expansion, so it is silenced deliberately.
# shellcheck disable=SC2029
ssh_run() { ssh "${SSH_ARGS[@]}" "$HOST" "$@"; }

fetch_path() {
  local remote="$1" local_path="$2"
  [[ -n "$remote" && -n "$local_path" ]] || die "--fetch needs REMOTE_PATH and LOCAL_PATH"
  mkdir -p "$(dirname "$local_path")"
  # scp spells the port -P and the config -F, so the ssh argument array cannot be
  # reused verbatim; -F is common to both and -p/-P is the one that differs.
  if [[ -n "${MAC_TEST_HOST:-}" ]]; then
    scp -P "$PORT" -r "$HOST:$remote" "$local_path"
  else
    scp "${SSH_ARGS[@]}" -r "$HOST:$remote" "$local_path"
  fi
  success "Fetched $remote to $local_path"
}

# The transfer must preserve two things, and both fail far from their cause:
#
#   .git        tests/format.sh runs `gitleaks detect --source`, which scans
#               commit history. Without a repository it fails outright under
#               REQUIRE_LINTERS=1, so a plain file copy silently costs the
#               secret scan.
#   mode bits   31 files are executable. tests/chezmoi-templates.sh asserts every
#               script path a template emits is -x, so a mode-losing copy is
#               reported as a chezmoi problem.
#
# Hence rsync -a, no .git exclusion, and the verification below.
sync_tree() {
  # An array, not a string. This file sets IFS=$'\n\t' like every other script
  # here, so a space-separated string does not word-split and rsync receives one
  # long unknown option.
  local flags=(-az --delete --exclude=.DS_Store)
  if [[ "$DRY_RUN" == true ]]; then
    flags+=(--dry-run --itemize-changes)
  fi
  if command_exists rsync; then
    # rsync creates the final directory but not its parents, so the first sync to
    # a fresh VM fails on the missing ~/workspace. --mkpath would cover it but
    # needs rsync 3.2.3+, and macOS ships an older rsync or openrsync.
    [[ "$DRY_RUN" == true ]] || ssh_run "mkdir -p '$REMOTE_DIR'"
    rsync "${flags[@]}" -e "$SSH_COMMAND" "$ROOT/" "$HOST:$REMOTE_DIR/"
  else
    [[ "$DRY_RUN" == true ]] && die "--dry-run needs rsync."
    warn "rsync is not installed; falling back to tar over ssh (no deletions)."
    tar -C "$(dirname "$ROOT")" -czf - "$(basename "$ROOT")" |
      ssh_run "mkdir -p '$(dirname "$REMOTE_DIR")' && tar -C '$(dirname "$REMOTE_DIR")' -xzf -"
  fi
}

# Checked on the remote rather than assumed, because both failures surface later
# as something else entirely.
verify_transfer() {
  ssh_run "test -d '$REMOTE_DIR/.git'" ||
    die "The remote checkout has no .git directory. gitleaks scans commit
history and will fail under REQUIRE_LINTERS=1. Re-sync; do not work around it
with --no-git, which skips history and defeats the check."
  ssh_run "test -x '$REMOTE_DIR/bootstrap' && test -x '$REMOTE_DIR/script/test'" ||
    die "Executable bits were lost in transfer. Repository scripts will not run
and tests/chezmoi-templates.sh will report it as a chezmoi error."
}

# `ssh host command` gets a NON-INTERACTIVE, NON-LOGIN shell, which reads only
# ~/.zshenv. This repository puts `brew shellenv` in ~/.zshrc, an interactive
# file, so Homebrew is absent from PATH here: chezmoi, shellcheck, shfmt and
# gitleaks would all report as not installed and the strict test run would be
# impossible. Every chezmoi run script solves it the same way, so this does too.
#
# The command is assembled with a LOCAL IFS of a single space.
#
# "$*" joins on the first character of IFS, and this file sets IFS=$'\n\t' like
# every other script here, so it joined on a NEWLINE: `sync-to-mac ./script/vm
# down` arrived at the remote shell as two separate commands on two lines. The
# documented invocations all pass a single word, which is why it went unnoticed —
# but the failure could invert intent rather than merely break. `sync-to-mac
# ./script/macos-defaults --dry-run` would have run ./script/macos-defaults, whose
# default mode is apply, and then `--dry-run` as its own command.
#
# script/AGENTS.md already states the rule this violated; sync_tree above obeys it
# for rsync's flags.
remote_command() {
  # Each argument is RE-QUOTED, not merely joined.
  #
  # `local IFS=' '` plus "$*" fixed the newline-joining bug but not the real one: ssh
  # hands the joined string to the remote login shell, which parses it AGAIN. Any
  # argument containing a space is therefore split back into several. Observed on the
  # first real destructive run —
  #   ./bootstrap install ... --git-name Workstation Test ...
  #   [ERROR] Unknown option: Test
  # — so the test could never have passed with a multi-word Git name, which is the
  # normal case.
  #
  # printf '%q' per argument survives exactly one round of remote parsing. A loop
  # rather than a quoted array slice: bash 3.2 joins those instead of expanding them.
  local arg command='' separator=''
  for arg in "$@"; do
    command+="$separator$(printf '%q' "$arg")"
    separator=' '
  done
  ssh "${SSH_ARGS[@]}" -t "$HOST" "
    for b in /opt/homebrew/bin/brew; do
      [ -x \"\$b\" ] && { eval \"\$(\$b shellenv)\"; break; }
    done
    cd '$REMOTE_DIR' || exit 1
    $command
  "
}

if [[ "$FETCH" == true ]]; then
  fetch_path "${1:-}" "${2:-}"
  exit 0
fi

log "Syncing $ROOT to $HOST:$REMOTE_DIR"
sync_tree

if [[ "$DRY_RUN" == true ]]; then
  log "Dry run only; nothing was transferred."
  exit 0
fi

verify_transfer
success "Synced, with .git and executable bits intact."

if (($# > 0)); then
  # A space-joined copy for the log only. Outside remote_command IFS is still
  # $'\n\t', so "$*" here printed one argument per line and made the failure it was
  # meant to illuminate harder to read.
  printed="$(printf '%s ' "$@")"
  log "Running on $HOST: ${printed% }"
  # The exit status is forwarded on purpose, so a failing remote test fails this
  # command and the fix/sync/test loop cannot report a false pass.
  remote_command "$@"
fi
