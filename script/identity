#!/usr/bin/env bash
# Report whether this machine's identity is complete, and restore the part that can be.
#
# Packages are reproducible from this repository; identity is not, and that asymmetry is
# what makes a "new Mac" procedure either portable or lossy. Nothing else in the repo
# answered the question, so a machine could pass ./script/verify and ./script/hardening-check
# while being unable to decrypt a single secret or sign a single commit.
#
# The two halves are deliberately different:
#
#   age  — RESTORED from Bitwarden. Files encrypted to an identity you no longer hold are
#          unrecoverable, so a second identity is data loss, not an inconvenience.
#   ssh  — GENERATED per machine and never moved. A signing key has no such property: a new
#          one is simply enrolled, and a key that never leaves its machine cannot be exposed
#          by the loss of a different one.
#
#   identity            report; non-zero when something required is missing
#   identity --check    the same, and what script/verify calls
#   identity --restore  fetch the age identity out of Bitwarden onto this machine
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"

AGE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/age"
AGE_KEY="$AGE_DIR/keys.txt"
AGE_MARKER="$AGE_DIR/.locally-generated"
SSH_KEY="$HOME/.ssh/id_ed25519"
BW_ITEM="${AGE_BW_ITEM:-age-identity}"

MODE="check"

usage() {
  cat <<'EOF'
Usage: script/identity [--check|--restore]

  --check     report the state of this machine's identity (default)
  --restore   fetch the age identity from Bitwarden

Environment:
  AGE_BW_ITEM  Bitwarden item holding the age identity (default: age-identity)
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) MODE="check" ;;
    --restore) MODE="restore" ;;
    --help | -h)
      usage
      exit 0
      ;;
    *) die "Unknown option: $1" ;;
  esac
  shift
done

failures=0
pass() { printf '%s[PASS]%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
fail() {
  printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RESET" "$*"
  failures=$((failures + 1))
}

# Mode is checked separately from presence, because a private key the group can read is
# refused by ssh outright and silently distrusted by age.
check_mode() {
  local file="$1" want="$2" actual
  actual="$(stat -f '%OLp' "$file" 2>/dev/null || echo '???')"
  [[ "$actual" == "$want" ]]
}

do_restore() {
  command_exists bw ||
    die "The Bitwarden CLI is not installed. It is declared in
profiles/password-bitwarden.Brewfile; run ./script/setup, or brew install bitwarden-cli."

  if [[ -f "$AGE_KEY" ]]; then
    warn "An age identity already exists at $AGE_KEY."
    confirm "Replace it with the one from Bitwarden?" || die "Cancelled."
  fi

  # bw needs an unlocked vault. It reads BW_SESSION, so the caller runs
  # `export BW_SESSION="$(bw unlock --raw)"` first; this only reports the failure clearly
  # rather than trying to prompt for a master password itself.
  mkdir -p "$AGE_DIR"
  umask 077
  local tmp="$AGE_KEY.tmp"
  if ! bw get notes "$BW_ITEM" >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    die "Could not read Bitwarden item '$BW_ITEM'. Unlock the vault first:
  export BW_SESSION=\"\$(bw unlock --raw)\"
then re-run. Set AGE_BW_ITEM if the item has a different name."
  fi
  grep -q 'AGE-SECRET-KEY-' "$tmp" || {
    rm -f "$tmp"
    die "Bitwarden item '$BW_ITEM' does not contain an age secret key."
  }

  mv "$tmp" "$AGE_KEY"
  chmod 600 "$AGE_KEY"
  rm -f "$AGE_MARKER"
  success "Restored the age identity from Bitwarden item '$BW_ITEM'."
  log "Public key: $(age-keygen -y "$AGE_KEY" 2>/dev/null || echo 'unreadable')"
}

do_check() {
  echo
  echo '== age identity =='
  if [[ ! -f "$AGE_KEY" ]]; then
    fail "No age identity at $AGE_KEY. SOPS cannot decrypt anything.
  Restore it with:  ./script/identity --restore"
  else
    if check_mode "$AGE_KEY" 600; then
      pass "age identity present at $AGE_KEY (0600)."
    else
      fail "$AGE_KEY is not mode 0600."
    fi
    if [[ -f "$AGE_MARKER" ]]; then
      # Deliberately a failure, not a warning. A key that exists only on this machine is
      # one disk failure away from taking every encrypted file with it, and the whole
      # point of the marker is that this stays visible until it is resolved.
      fail "This age identity was generated locally and is NOT in Bitwarden.
  Store $AGE_KEY as a secure note in an item named '$BW_ITEM',
  then remove $AGE_MARKER"
    else
      pass "age identity came from the vault, or has been confirmed backed up."
    fi
  fi

  echo
  echo '== ssh key =='
  if [[ ! -f "$SSH_KEY" ]]; then
    fail "No SSH key at $SSH_KEY. It is generated by chezmoi apply."
  else
    if check_mode "$SSH_KEY" 600; then
      pass "SSH key present at $SSH_KEY (0600)."
    else
      fail "$SSH_KEY is not mode 0600; ssh will refuse it."
    fi
    if [[ -f "$SSH_KEY.pub" ]]; then
      # The fingerprint, not a slice of the file. `cut -d' ' -f3` took the COMMENT field
      # and stopped at its first space, so a machine named "admin's Mac" reported
      # "Public key: admin@admin's" — which is not a public key, and is not comparable to
      # anything GitHub shows you. The fingerprint is what the forge displays next to an
      # enrolled key, so it is the value worth printing.
      pass "SSH key fingerprint: $(ssh-keygen -lf "$SSH_KEY.pub" 2>/dev/null || echo 'unreadable')"
    else
      fail "$SSH_KEY.pub is missing, so the key cannot be enrolled."
    fi
  fi

  echo
  echo '== commit signing =='
  local method key
  method="$(git config --get gpg.format 2>/dev/null || echo 'gpg')"
  key="$(git config --get user.signingkey 2>/dev/null || true)"
  if [[ -z "$key" ]]; then
    pass "No signing key configured, so nothing to verify."
  elif [[ "$method" == ssh ]]; then
    # Only a path is checked, not a signature: producing one would write a commit object
    # somewhere, and a check that mutates state to prove itself is the wrong trade.
    if [[ "$key" == key::* ]] || [[ -f "${key/#\~/$HOME}" ]]; then
      pass "ssh signing key resolves: $key"
    else
      fail "user.signingkey is set to '$key', which is neither a key:: literal nor a file."
    fi
  else
    pass "gpg signing configured with key $key."
  fi

  echo
  if ((failures == 0)); then
    success 'Identity is complete on this machine.'
    return 0
  fi
  die "$failures identity check(s) failed. See docs/NEW-MACHINE.md."
}

case "$MODE" in
  check) do_check ;;
  restore) do_restore ;;
esac
