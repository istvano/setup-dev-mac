#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"

require_supported_mac
for command in brew chezmoi jq; do
  command_exists "$command" || die "$command is required for verification."
done

selection="$(chezmoi data)"
profiles="$(jq -er '.profiles | join(",")' <<<"$selection")"
# Named explicitly rather than left to jq's own error text. A configuration
# predating this key must fail loudly and be migrated, not be verified against
# the wrong shell fragment — but "jq: error: null has no ..." does not say so.
shell_choice="$(jq -er '.shell' <<<"$selection")" || die "chezmoi data has no 'shell' key.
Run 'chezmoi init --source $ROOT' to add it, or see docs/OPERATIONS.md,
\"Migrating an older configuration\"."
runtime="$(jq -er '.runtime' <<<"$selection")"
password_manager="$(jq -er '.passwordManager' <<<"$selection")"
firewall="$(jq -er '.firewall' <<<"$selection")"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/workstation-verify.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
brewfile="$tmp_dir/Brewfile"
"$ROOT/script/render-brewfile" \
  --profiles "$profiles" \
  --shell "$shell_choice" \
  --runtime "$runtime" \
  --password-manager "$password_manager" \
  --firewall "$firewall" \
  --output "$brewfile"

brew bundle check --verbose --file="$brewfile"
chezmoi doctor
success "Selected workstation state is installed and chezmoi is healthy."
