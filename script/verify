#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=script/lib/common.sh
source "$ROOT/script/lib/common.sh"

require_supported_mac
for command in brew chezmoi jq; do
  command_exists "$command" || die "$command is required for verification."
done

selection="$(chezmoi data)"
profiles="$(jq -er '.profiles | join(",")' <<<"$selection")"
# Named explicitly rather than left to jq's own error text. A configuration
# predating this key must fail loudly and be migrated, not be verified against
# the wrong shell fragment — but "jq: error: null has no ..." does not say so.
shell_choice="$(jq -er '.shell' <<<"$selection")" || die "chezmoi data has no 'shell' key.
Run 'chezmoi init --source $ROOT' to add it, or see docs/OPERATIONS.md,
\"Migrating an older configuration\"."
runtime="$(jq -er '.runtime' <<<"$selection")"
password_manager="$(jq -er '.passwordManager' <<<"$selection")"
firewall="$(jq -er '.firewall' <<<"$selection")"

tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/workstation-verify.XXXXXX")"
trap 'rm -rf "$tmp_dir"' EXIT
brewfile="$tmp_dir/Brewfile"
"$ROOT/script/render-brewfile" \
  --profiles "$profiles" \
  --shell "$shell_choice" \
  --runtime "$runtime" \
  --password-manager "$password_manager" \
  --firewall "$firewall" \
  --output "$brewfile"

brew bundle check --verbose --file="$brewfile"
chezmoi doctor

# Identity is reported here but does not fail this command.
#
# ./script/verify answers "is the declared state installed", and identity is not declared
# state — it is the part of a machine this repository deliberately cannot reproduce. A
# machine can be correctly provisioned and still be unable to decrypt a secret or sign a
# commit, and until now nothing said so: verify and hardening-check both passed while the
# age key was missing entirely.
#
# Non-fatal because the failure is not always the machine's fault (a locked vault, a key
# the operator manages by hand), and because making a green verify depend on a vault
# unlock would push people to stop running it. script/identity --check is the gate when
# a gate is wanted.
echo
if "$ROOT/script/identity" --check; then
  :
else
  warn "Identity is incomplete on this machine; see the report above."
  warn "This does not affect the installed state. Details: docs/NEW-MACHINE.md"
fi

success "Selected workstation state is installed and chezmoi is healthy."
