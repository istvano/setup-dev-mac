#!/usr/bin/env bash
set -Eeuo pipefail
check_cmd() { command -v "$1" >/dev/null 2>&1 && printf '[OK]      %-20s %s\n' "$1" "$(command -v "$1")" || printf '[MISSING] %-20s\n' "$1"; }
check_app() { [[ -d "/Applications/$1.app" || -d "$HOME/Applications/$1.app" ]] && printf '[OK]      %s.app\n' "$1" || printf '[MISSING] %s.app\n' "$1"; }
for command in brew git gh chezmoi mise uv direnv tmux rg fd fzf jq yq docker kubectl helm k9s aws az gcloud tofu ansible nmap mitmproxy age sops; do check_cmd "$command"; done
for app in Ghostty 'Visual Studio Code' Zed Wireshark 'Burp Suite Community Edition' DBeaver Bruno BetterDisplay; do check_app "$app"; done
command -v chezmoi >/dev/null 2>&1 && chezmoi doctor || true
