brew "kubectl"       # Kubernetes cluster command-line client.
brew "helm"          # Kubernetes package and release manager.
brew "k9s"           # Terminal UI for interactive Kubernetes operations.
brew "kubectx"       # Fast Kubernetes context and namespace switching.
brew "stern"         # Concurrent log tailing across Kubernetes pods.
brew "awscli"        # AWS control-plane command-line client.
brew "azure-cli"     # Microsoft Azure control-plane command-line client.
cask "gcloud-cli"    # Google Cloud control-plane command-line client.
brew "opentofu"      # Open-source infrastructure-as-code provisioning CLI.
brew "ansible"       # Agentless remote configuration and automation tool.
brew "cloudflared"   # Cloudflare Tunnel and DNS command-line client.
brew "grpcurl"       # Interactive command-line client for gRPC services.
brew "websocat"      # Command-line client and relay for WebSocket endpoints.
brew "hurl"          # Text-driven HTTP request and integration-test runner.
