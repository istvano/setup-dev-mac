# Bootstrap and configuration
brew "mas"       # Mac App Store CLI.
brew "mise"      # Project runtime and tool-version manager.
brew "uv"        # Python versions, environments and locking.
brew "direnv"    # Reviewed per-directory environment activation.
brew "chezmoi"   # Configuration engine.

# Terminal and shell
brew "starship"
brew "tmux"
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"

# Core CLI
brew "ripgrep"
brew "fd"
brew "fzf"
brew "bat"
brew "eza"
brew "zoxide"
brew "jq"
brew "yq"
brew "git-delta"
brew "btop"
brew "dust"
brew "sd"
brew "hyperfine"
brew "tealdeer"
brew "tree"
brew "watch"
brew "wget"
brew "httpie"
brew "xh"
brew "duf"
brew "procs"
brew "just"
brew "watchexec"

# Quality and version control
brew "shellcheck"
brew "shfmt"
brew "actionlint"
brew "hadolint"
brew "yamllint"
brew "git"
brew "git-lfs"
brew "gh"
brew "lazygit"
brew "pre-commit"
brew "gitleaks" # Fast native pre-commit secret detection.
