brew "nmap"            # Host-network discovery, port scanning and service inspection.
brew "mitmproxy"       # Interactive HTTP and HTTPS interception on host interfaces.
brew "age"             # Small file-encryption CLI for configuration and backups.
brew "sops"            # Structured secret-file encryption using age or cloud KMS.
brew "openssl@3"       # TLS, certificate and cryptographic inspection toolkit.
brew "step"            # CLI for certificates, keys and smallstep PKI workflows.
brew "mkcert"          # Locally trusted development-certificate generator.
brew "wireguard-tools" # WireGuard key and tunnel configuration utilities.
cask "wireshark"       # Native packet capture and protocol-analysis GUI.
cask "burp-suite"      # Native interactive web security testing proxy.
cask "knockknock"      # Native inspection of persistent macOS startup items.
cask "blockblock"      # Native monitor for newly installed persistence mechanisms.
cask "oversight"       # Native monitor for microphone and camera activation.
cask "taskexplorer"    # Native inspection of running processes and their activity.
# Automated scanners are container wrappers; exploit tooling belongs in a VM.
