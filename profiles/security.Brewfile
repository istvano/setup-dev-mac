# Kept deliberately small. The secure-workstation baseline lives in core (gnupg,
# gitleaks, age) and in the firewall and password-manager fragments. Tools for
# doing security work, rather than for being secure, belong in security-extra.
brew "openssl@3" # TLS, certificate and cryptographic inspection toolkit.

#brew "testssl"   # Scriptable TLS configuration and cipher inspection against host-reachable endpoints.
#brew "sslscan"   # Fast TLS cipher and certificate enumeration for interactive checks.
#brew "socat"     # Bidirectional stream relay for raw host socket work.
#brew "doggo"     # DNS client with DoH/DoT support for resolution troubleshooting.
#brew "mtr"       # Combined traceroute and packet-loss measurement on host interfaces.

# mitmproxy now lives in security-extra, alongside the other intercepting proxy.
#cask "wireshark-app"      # Native packet capture and protocol-analysis GUI.
#cask "wireshark-chmodbpf" # Capture-permission helper so Wireshark need not run as root.

# Automated scanners are container wrappers; exploit tooling belongs in a VM.
