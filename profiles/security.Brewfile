brew "nmap"            # Host-network discovery, port scanning and service inspection.
brew "mitmproxy"       # Interactive HTTP and HTTPS interception on host interfaces.
brew "sops"            # Structured secret-file encryption using age or cloud KMS.
brew "openssl@3"       # TLS, certificate and cryptographic inspection toolkit.
cask "wireshark"       # Native packet capture and protocol-analysis GUI.
# Automated scanners are container wrappers; exploit tooling belongs in a VM.
