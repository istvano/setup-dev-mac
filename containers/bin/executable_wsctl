#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"; COMPOSE="$ROOT/compose.yaml"; SOURCES="$ROOT/images.sources.env"; LOCK="$ROOT/images.lock.env"; REPORTS="$ROOT/reports"; SECRETS="$ROOT/secrets"
die() { echo "[ERROR] $*" >&2; exit 1; }
need_docker() { command -v docker >/dev/null 2>&1 || die 'docker missing'; docker info >/dev/null 2>&1 || die 'runtime not running'; }
load_lock() { [[ -f "$LOCK" ]] || die 'run pin-images first'; set -a; source "$LOCK"; set +a; }
ensure_secrets() { mkdir -p "$SECRETS"; chmod 700 "$SECRETS"; [[ -f "$SECRETS/postgres_password" ]] || { umask 077; openssl rand -base64 36 >"$SECRETS/postgres_password"; }; }
pin_images() { need_docker; tmp="$(mktemp)"; printf '# generated %s\n' "$(date -u +%FT%TZ)" >"$tmp"; while IFS= read -r line || [[ -n "$line" ]]; do [[ -z "$line" || "$line" == \#* ]] && continue; key="${line%%=*}"; source="${line#*=}"; image_key="${key%_SOURCE}_IMAGE"; docker pull "$source"; digest="$(docker image inspect --format '{{index .RepoDigests 0}}' "$source")"; printf '%s=%s\n' "$image_key" "$digest" >>"$tmp"; done <"$SOURCES"; mv "$tmp" "$LOCK"; chmod 600 "$LOCK"; }
compose() { load_lock; ensure_secrets; docker compose --env-file "$LOCK" -f "$COMPOSE" "$@"; }
scan() { scanner="${1:-}"; target="$(cd "${2:-$PWD}" && pwd)"; need_docker; load_lock; case "$scanner" in trivy) docker run --rm --mount "type=bind,src=$target,dst=/src,readonly" "$TRIVY_IMAGE" fs /src ;; syft) docker run --rm --mount "type=bind,src=$target,dst=/src,readonly" "$SYFT_IMAGE" dir:/src -o cyclonedx-json ;; grype) docker run --rm --mount "type=bind,src=$target,dst=/src,readonly" "$GRYPE_IMAGE" dir:/src ;; semgrep) docker run --rm --mount "type=bind,src=$target,dst=/src,readonly" "$SEMGREP_IMAGE" semgrep scan --config auto /src ;; checkov) docker run --rm --mount "type=bind,src=$target,dst=/src,readonly" "$CHECKOV_IMAGE" -d /src ;; *) die 'unknown scanner' ;; esac; }
case "${1:-help}" in
  pin-images) pin_images ;;
  up) need_docker; profile="${2:-all}"; [[ "$profile" == all ]] && compose --profile ai --profile data up -d || compose --profile "$profile" up -d ;;
  down) need_docker; compose --profile ai --profile data down ;;
  status) need_docker; compose --profile ai --profile data ps ;;
  scan) shift; scan "$@" ;;
  zap-baseline)
    target="${2:-}"; [[ -n "$target" ]] || die 'target required'
    need_docker; load_lock; mkdir -p "$REPORTS"
    docker run --rm --mount "type=bind,src=$REPORTS,dst=/zap/wrk" "$ZAP_IMAGE" zap-baseline.py -t "$target" -r zap-baseline.html
    ;;
  prowler-aws)
    need_docker; load_lock
    [[ -n "${AWS_ACCESS_KEY_ID:-}" && -n "${AWS_SECRET_ACCESS_KEY:-}" ]] || die 'export short-lived AWS credentials first'
    shift
    docker run --rm \
      -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY -e AWS_SESSION_TOKEN \
      -e AWS_REGION -e AWS_DEFAULT_REGION \
      "$PROWLER_IMAGE" aws "$@"
    ;;
  *) echo 'wsctl pin-images|up ai|data|all|down|status|scan ...|zap-baseline URL|prowler-aws [args]' ;;
esac
